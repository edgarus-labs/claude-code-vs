<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <RootNamespace>ClaudeCode.Core</RootNamespace>
    <AssemblyName>EdgarusLabs.ClaudeCode.Core.ViewModels</AssemblyName>
    <!--
      XAML-free ViewModel/logic layer for ClaudeCode.Core. Split out of the WPF (net472) Core project so it
      can be exercised by a fast, portable net8.0 xunit test host: net472 test assemblies cannot execute on
      this Linux dev box without Mono (verified: `dotnet test` fails with
      "Could not find 'mono' host"), even though net472+UseWPF XAML/BAML compilation itself works fine here.
      ClaudeCode.Core (the WPF project) references this assembly for all ChatViewModel/* types; the XAML
      views are the only thing left in ClaudeCode.Core itself.
    -->
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.3.2" />
    <!-- Local inference for Auto effort (Effort\MiniLmEncoder.cs). The managed API is netstandard2.0 and
         depends only on System.Memory; the package also carries the native win-x64/linux-x64 runtimes. -->
    <PackageReference Include="Microsoft.ML.OnnxRuntime" Version="1.30.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- Auto effort's local classifier: frozen all-MiniLM-L6-v2 (Apache-2.0) plus the trained
         384 -> 3 head. Loaded lazily from beside the assembly, only when Auto is used. -->
    <Content Include="Effort\Model\**\*.*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../ClaudeCode.Contracts/ClaudeCode.Contracts.csproj" />
  </ItemGroup>

</Project>
