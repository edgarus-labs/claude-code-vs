<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

	<!-- Core stays VS-SDK-free. Surface/text colors below are standalone fallbacks;
	     the VSIX host overrides those keys directly on ChatPanelView.Resources.
	     Brand accent/focus keys deliberately retain the existing Claude icon orange. -->

	<Color x:Key="ChatBackgroundColor">#FF1E1E1E</Color>
	<Color x:Key="ChatForegroundColor">#FFD4D4D4</Color>
	<Color x:Key="ChatSubtleForegroundColor">#FF9D9D9D</Color>
	<Color x:Key="ChatBorderColor">#FF3F3F46</Color>
	<Color x:Key="ChatUserBubbleBackgroundColor">#FF264F78</Color>
	<Color x:Key="ChatInputBackgroundColor">#FF252526</Color>
	<Color x:Key="ChatAccentColor">#FFD97757</Color>
	<Color x:Key="ChatAccentForegroundColor">#FF211A17</Color>
	<Color x:Key="ChatLinkColor">#FFD97757</Color>
	<Color x:Key="ChatDiffAddedBackgroundColor">#FF1B3B1B</Color>
	<Color x:Key="ChatDiffAddedForegroundColor">#FF6A9955</Color>
	<Color x:Key="ChatDiffRemovedBackgroundColor">#FF3B1B1B</Color>
	<Color x:Key="ChatDiffRemovedForegroundColor">#FFF14C4C</Color>
	<Color x:Key="ChatErrorForegroundColor">#FFF14C4C</Color>
	<Color x:Key="ChatWarningBackgroundColor">#FF3B3315</Color>
	<Color x:Key="ChatCodeKeywordColor">#FF569CD6</Color>
	<Color x:Key="ChatCodeStringColor">#FFD69D85</Color>
	<Color x:Key="ChatCodeNumberColor">#FF6A9E8F</Color>

	<SolidColorBrush x:Key="ChatBackgroundBrush" Color="{StaticResource ChatBackgroundColor}" />
	<SolidColorBrush x:Key="ChatForegroundBrush" Color="{StaticResource ChatForegroundColor}" />
	<SolidColorBrush x:Key="ChatSubtleForegroundBrush" Color="{StaticResource ChatSubtleForegroundColor}" />
	<SolidColorBrush x:Key="ChatBorderBrush" Color="{StaticResource ChatBorderColor}" />
	<SolidColorBrush x:Key="ChatUserBubbleBackgroundBrush" Color="{StaticResource ChatUserBubbleBackgroundColor}" />
	<SolidColorBrush x:Key="ChatInputBackgroundBrush" Color="{StaticResource ChatInputBackgroundColor}" />
	<SolidColorBrush x:Key="ChatAccentBrush" Color="{StaticResource ChatAccentColor}" />
	<SolidColorBrush x:Key="ChatAccentForegroundBrush" Color="{StaticResource ChatAccentForegroundColor}" />
	<SolidColorBrush x:Key="ChatLinkBrush" Color="{StaticResource ChatLinkColor}" />
	<SolidColorBrush x:Key="ChatDiffAddedBackgroundBrush" Color="{StaticResource ChatDiffAddedBackgroundColor}" />
	<SolidColorBrush x:Key="ChatDiffAddedForegroundBrush" Color="{StaticResource ChatDiffAddedForegroundColor}" />
	<SolidColorBrush x:Key="ChatDiffRemovedBackgroundBrush" Color="{StaticResource ChatDiffRemovedBackgroundColor}" />
	<SolidColorBrush x:Key="ChatDiffRemovedForegroundBrush" Color="{StaticResource ChatDiffRemovedForegroundColor}" />
	<SolidColorBrush x:Key="ChatErrorForegroundBrush" Color="{StaticResource ChatErrorForegroundColor}" />
	<SolidColorBrush x:Key="ChatWarningBackgroundBrush" Color="{StaticResource ChatWarningBackgroundColor}" />
	<SolidColorBrush x:Key="ChatCodeKeywordBrush" Color="{StaticResource ChatCodeKeywordColor}" />
	<SolidColorBrush x:Key="ChatCodeStringBrush" Color="{StaticResource ChatCodeStringColor}" />
	<SolidColorBrush x:Key="ChatCodeNumberBrush" Color="{StaticResource ChatCodeNumberColor}" />
	<SolidColorBrush x:Key="ChatPopupBackgroundBrush" Color="#FF252526" />
	<SolidColorBrush x:Key="ChatRemoteControlBrush" Color="#FF3B6FD9" />
	<SolidColorBrush x:Key="ChatHoverBrush" Color="#FF3A3A3C" />
	<SolidColorBrush x:Key="ChatHoverForegroundBrush" Color="{StaticResource ChatForegroundColor}" />
	<SolidColorBrush x:Key="ChatSelectionBrush" Color="#FF3F3F46" />
	<SolidColorBrush x:Key="ChatSelectionForegroundBrush" Color="{StaticResource ChatForegroundColor}" />
	<SolidColorBrush x:Key="ChatFocusBrush" Color="{StaticResource ChatAccentColor}" />
	<!-- The Claude accent at low alpha: a selection fill that reads as "chosen" on both the dark
	     fallback surface and the light VS themes, because it tints whatever is behind it instead of
	     replacing it. A theme-specific opaque colour cannot do that, and ChatSelectionBrush is the
	     VS list-selection colour, legible only against ChatSelectionForegroundBrush. -->
	<SolidColorBrush x:Key="ChatAccentSoftBrush" Color="{StaticResource ChatAccentColor}" Opacity="0.22" />
</ResourceDictionary>
