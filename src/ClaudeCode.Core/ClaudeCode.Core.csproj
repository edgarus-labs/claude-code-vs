<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <UseWPF>true</UseWPF>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <RootNamespace>ClaudeCode.Core</RootNamespace>
    <AssemblyName>EdgarusLabs.ClaudeCode.Core</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.3240.44" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../ClaudeCode.Contracts/ClaudeCode.Contracts.csproj" />
    <!--
      Not "Contracts only": also references the sibling ClaudeCode.Core.ViewModels project, which holds every
      XAML-free ChatViewModel/* type. That split exists purely so the view-model logic is unit-testable from
      a portable net8.0 xunit host - net472 test assemblies cannot execute on Linux without Mono (verified),
      even though net472+UseWPF XAML/BAML compilation itself works fine here. Both projects are owned by this
      task; ClaudeCode.Acp and ClaudeCode.Vsix are still never referenced.
    -->
    <ProjectReference Include="../ClaudeCode.Core.ViewModels/ClaudeCode.Core.ViewModels.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The transcript's WebView2 page (see Views/ChatPanelView.xaml.cs). Resolved at runtime
         relative to this assembly's own location, so it must sit alongside the built DLL both
         here (F5/local build) and in the packaged .vsix (ClaudeCode.Vsix.csproj mirrors this
         same Content group so it ends up in the same flattened extension folder). -->
    <Content Include="Resources\Transcript\**\*.*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

</Project>
