<UserControl
	x:Class="ClaudeCode.Core.Views.ChatPanelView"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:contracts="clr-namespace:ClaudeCode.Contracts;assembly=EdgarusLabs.ClaudeCode.Contracts"
	xmlns:conv="clr-namespace:ClaudeCode.Core.Views.Converters"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	xmlns:views="clr-namespace:ClaudeCode.Core.Views"
	xmlns:vm="clr-namespace:ClaudeCode.Core.ViewModels;assembly=EdgarusLabs.ClaudeCode.Core.ViewModels"
	xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
	x:Name="ChatPanel"
	d:DesignHeight="640"
	d:DesignWidth="360"
	Background="{DynamicResource ChatBackgroundBrush}"
	SnapsToDevicePixels="True"
	TextElement.Foreground="{DynamicResource ChatForegroundBrush}"
	UseLayoutRounding="True"
	mc:Ignorable="d">

	<UserControl.Resources>
		<ResourceDictionary>
			<ResourceDictionary.MergedDictionaries>
				<ResourceDictionary Source="/EdgarusLabs.ClaudeCode.Core;component/Themes/ChatBrushes.xaml" />
			</ResourceDictionary.MergedDictionaries>

			<conv:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
			<conv:NullToVisibilityConverter x:Key="NullToVisibilityConverter" />
			<conv:PlanStatusGlyphConverter x:Key="PlanStatusGlyphConverter" />
			<views:ChatTextFontSizeConverter x:Key="ChatTextFontSizeConverter" />
			<conv:RelativeTimeConverter x:Key="RelativeTimeConverter" />
			<conv:SessionTitleConverter x:Key="SessionTitleConverter" />
			<conv:PercentToStarWidthConverter x:Key="PercentToStarWidthConverter" />
			<conv:PercentToDashArrayConverter x:Key="PercentToDashArrayConverter" />
			<conv:SessionModeGlyphConverter x:Key="SessionModeGlyphConverter" />
			<conv:Base64ToImageSourceConverter x:Key="Base64ToImageSourceConverter" />
			<conv:SingleLineHeightConverter x:Key="SingleLineHeightConverter" />

			<Style x:Key="ButtonIconStrokeStyle" TargetType="Path">
				<Setter Property="Stroke" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
			</Style>

			<Style x:Key="ChatButtonStyle" TargetType="Button">
				<Setter Property="Background" Value="{DynamicResource ChatAccentBrush}" />
				<Setter Property="Foreground" Value="{DynamicResource ChatAccentForegroundBrush}" />
				<Setter Property="BorderBrush" Value="Transparent" />
				<Setter Property="BorderThickness" Value="1" />
				<Setter Property="Padding" Value="12,6" />
				<Setter Property="Cursor" Value="Hand" />
				<Setter Property="Template">
					<Setter.Value>
						<ControlTemplate TargetType="Button">
							<Border
								x:Name="Bd"
								Padding="{TemplateBinding Padding}"
								Background="{TemplateBinding Background}"
								BorderBrush="{TemplateBinding BorderBrush}"
								BorderThickness="{TemplateBinding BorderThickness}"
								CornerRadius="8">
								<ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center" />
							</Border>
							<ControlTemplate.Triggers>
								<Trigger Property="IsMouseOver" Value="True">
									<Setter TargetName="Bd" Property="Opacity" Value="0.85" />
								</Trigger>
								<Trigger Property="IsPressed" Value="True">
									<Setter TargetName="Bd" Property="Opacity" Value="0.65" />
								</Trigger>
								<Trigger Property="IsKeyboardFocused" Value="True">
									<Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource ChatFocusBrush}" />
								</Trigger>
								<Trigger Property="IsEnabled" Value="False">
									<Setter TargetName="Bd" Property="Opacity" Value="0.45" />
								</Trigger>
							</ControlTemplate.Triggers>
						</ControlTemplate>
					</Setter.Value>
				</Setter>
				<Setter Property="HorizontalContentAlignment" Value="Center" />
			</Style>

			<Style
				x:Key="LinkButtonStyle"
				BasedOn="{StaticResource ChatButtonStyle}"
				TargetType="Button">
				<Setter Property="Background" Value="Transparent" />
				<Setter Property="Foreground" Value="{DynamicResource ChatSubtleForegroundBrush}" />
				<Setter Property="Padding" Value="6,2" />
				<Style.Triggers>
					<Trigger Property="IsMouseOver" Value="True">
						<Setter Property="Background" Value="{DynamicResource ChatHoverBrush}" />
						<Setter Property="Foreground" Value="{DynamicResource ChatHoverForegroundBrush}" />
					</Trigger>
				</Style.Triggers>
			</Style>

			<Style x:Key="SectionToggleStyle" TargetType="ToggleButton">
				<Setter Property="Background" Value="Transparent" />
				<Setter Property="Foreground" Value="{DynamicResource ChatForegroundBrush}" />
				<Setter Property="HorizontalContentAlignment" Value="Stretch" />
				<Setter Property="Padding" Value="2,3" />
				<Setter Property="Cursor" Value="Hand" />
				<Setter Property="Template">
					<Setter.Value>
						<ControlTemplate TargetType="ToggleButton">
							<Border
								x:Name="Bd"
								Padding="{TemplateBinding Padding}"
								Background="{TemplateBinding Background}"
								BorderBrush="Transparent"
								BorderThickness="1"
								CornerRadius="6">
								<ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Center" />
							</Border>
							<ControlTemplate.Triggers>
								<Trigger Property="IsMouseOver" Value="True">
									<Setter TargetName="Bd" Property="Background" Value="{DynamicResource ChatHoverBrush}" />
								</Trigger>
								<Trigger Property="IsKeyboardFocused" Value="True">
									<Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource ChatFocusBrush}" />
								</Trigger>
							</ControlTemplate.Triggers>
						</ControlTemplate>
					</Setter.Value>
				</Setter>
			</Style>

			<Style x:Key="DraftControlStyle" TargetType="Control">
				<Style.Triggers>
					<DataTrigger Binding="{Binding IsBusy}" Value="True">
						<Setter Property="IsEnabled" Value="False" />
					</DataTrigger>
					<DataTrigger Binding="{Binding IsConfigBusy}" Value="True">
						<Setter Property="IsEnabled" Value="False" />
					</DataTrigger>
					<DataTrigger Binding="{Binding IsConnecting}" Value="True">
						<Setter Property="IsEnabled" Value="False" />
					</DataTrigger>
				</Style.Triggers>
			</Style>

			<Style x:Key="ComposerStyle" TargetType="TextBox">
				<Setter Property="IsReadOnlyCaretVisible" Value="True" />
				<Style.Triggers>
					<!--
						Deliberately NOT gated on IsBusy: the composer stays editable while a turn is in
						flight so the next message can be typed and queued (see ChatViewModel.EnqueueDraft)
						instead of blocking the user until the response finishes.
					-->
					<DataTrigger Binding="{Binding IsConfigBusy}" Value="True">
						<Setter Property="IsReadOnly" Value="True" />
					</DataTrigger>
					<DataTrigger Binding="{Binding IsConnecting}" Value="True">
						<Setter Property="IsReadOnly" Value="True" />
					</DataTrigger>
				</Style.Triggers>
			</Style>

			<Style x:Key="ConfigListStyle" TargetType="ListBox">
				<Setter Property="Background" Value="Transparent" />
				<Setter Property="Foreground" Value="{DynamicResource ChatForegroundBrush}" />
				<Setter Property="BorderThickness" Value="0" />
				<Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
				<!--
					Hidden, not Disabled: a ListBox always owns an internal ScrollViewer, and Disabled truly
					blocks scrolling, not just the bar. The Mode list keeps this bar-less style and scrolls
					with that inner ScrollViewer, by wheel and keyboard only. The Model and Effort lists use
					ConfigScrollingListStyle instead.
				-->
				<Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Hidden" />
				<Setter Property="HorizontalContentAlignment" Value="Stretch" />
				<Setter Property="KeyboardNavigation.DirectionalNavigation" Value="Contained" />
			</Style>

			<!--
				Model and Effort lists. They scroll with their own ScrollViewer, not a wrapping one: an
				inner ScrollViewer marks every wheel event handled even when it has nothing to scroll,
				so a wrapper around the list never sees the wheel. The bar appears once the agent
				advertises more entries than fit, and mirrors the transcript's ::-webkit-scrollbar rules
				(transcript.css), which follow the VS Code extension: a 10px lane with no track or arrow
				buttons, and a rounded 4px thumb in the foreground colour at 28% (45% while hovered or dragged).
			-->
			<Style
				x:Key="ConfigScrollingListStyle"
				BasedOn="{StaticResource ConfigListStyle}"
				TargetType="ListBox">
				<Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
				<Setter Property="ScrollViewer.CanContentScroll" Value="False" />
				<Style.Resources>
					<Style TargetType="ScrollBar">
						<Setter Property="Width" Value="10" />
						<Setter Property="MinWidth" Value="10" />
						<Setter Property="Background" Value="Transparent" />
						<Setter Property="Template">
							<Setter.Value>
								<ControlTemplate TargetType="ScrollBar">
									<Track x:Name="PART_Track" IsDirectionReversed="True">
										<Track.Thumb>
											<Thumb>
												<Thumb.Template>
													<ControlTemplate TargetType="Thumb">
														<Border Background="Transparent">
															<Border
																x:Name="ThumbFill"
																Margin="3"
																Background="{DynamicResource ChatForegroundBrush}"
																CornerRadius="2"
																Opacity="0.28" />
														</Border>
														<ControlTemplate.Triggers>
															<Trigger Property="IsMouseOver" Value="True">
																<Setter TargetName="ThumbFill" Property="Opacity" Value="0.45" />
															</Trigger>
															<Trigger Property="IsDragging" Value="True">
																<Setter TargetName="ThumbFill" Property="Opacity" Value="0.45" />
															</Trigger>
														</ControlTemplate.Triggers>
													</ControlTemplate>
												</Thumb.Template>
											</Thumb>
										</Track.Thumb>
									</Track>
								</ControlTemplate>
							</Setter.Value>
						</Setter>
					</Style>
				</Style.Resources>
			</Style>

			<Style x:Key="ConfigItemStyle" TargetType="ListBoxItem">
				<Setter Property="Background" Value="Transparent" />
				<Setter Property="Padding" Value="10,9" />
				<Setter Property="Margin" Value="0,1" />
				<Setter Property="HorizontalContentAlignment" Value="Stretch" />
				<Setter Property="AutomationProperties.Name" Value="{Binding Name}" />
				<Setter Property="AutomationProperties.HelpText" Value="{Binding Description}" />
				<Setter Property="Template">
					<Setter.Value>
						<ControlTemplate TargetType="ListBoxItem">
							<Border
								x:Name="ItemBorder"
								Padding="{TemplateBinding Padding}"
								Background="{TemplateBinding Background}"
								BorderBrush="Transparent"
								BorderThickness="1"
								CornerRadius="7">
								<ContentPresenter />
							</Border>
							<ControlTemplate.Triggers>
								<Trigger Property="IsMouseOver" Value="True">
									<Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource ChatHoverBrush}" />
									<Setter Property="Foreground" Value="{DynamicResource ChatHoverForegroundBrush}" />
								</Trigger>
								<Trigger Property="IsKeyboardFocusWithin" Value="True">
									<Setter TargetName="ItemBorder" Property="BorderBrush" Value="{DynamicResource ChatFocusBrush}" />
								</Trigger>
							</ControlTemplate.Triggers>
						</ControlTemplate>
					</Setter.Value>
				</Setter>
			</Style>

			<DataTemplate x:Key="ConfigValueTemplate" DataType="{x:Type contracts:SessionConfigValue}">
				<Grid>
					<Grid.ColumnDefinitions>
						<ColumnDefinition Width="*" />
						<ColumnDefinition Width="22" />
					</Grid.ColumnDefinitions>
					<StackPanel>
						<TextBlock
							FontSize="{Binding ChatTextFontSize, RelativeSource={RelativeSource AncestorType=views:ChatPanelView}, Converter={StaticResource ChatTextFontSizeConverter}, ConverterParameter=13}"
							FontWeight="SemiBold"
							Text="{Binding Name}"
							TextWrapping="Wrap" />
						<TextBlock
							Margin="0,3,0,0"
							FontSize="{Binding ChatTextFontSize, RelativeSource={RelativeSource AncestorType=views:ChatPanelView}, Converter={StaticResource ChatTextFontSizeConverter}, ConverterParameter=11}"
							Text="{Binding Description}"
							TextWrapping="Wrap"
							Visibility="{Binding Description, Converter={StaticResource NullToVisibilityConverter}}">
							<TextBlock.Style>
								<Style TargetType="TextBlock">
									<Setter Property="Foreground" Value="{DynamicResource ChatSubtleForegroundBrush}" />
									<Style.Triggers>
										<DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
											<Setter Property="Foreground" Value="{DynamicResource ChatHoverForegroundBrush}" />
										</DataTrigger>
									</Style.Triggers>
								</Style>
							</TextBlock.Style>
						</TextBlock>
					</StackPanel>
					<Path
						Grid.Column="1"
						HorizontalAlignment="Right"
						VerticalAlignment="Center"
						Data="M 1,6 L 5,10 L 12,2"
						Stroke="{DynamicResource ChatAccentBrush}"
						StrokeThickness="1.6"
						Visibility="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}, Converter={StaticResource BoolToVisibilityConverter}}" />
				</Grid>
			</DataTemplate>

			<!--  Session modes get an icon each (hand / pencil / list / bolt), like the VS Code extension's mode menu.  -->
			<DataTemplate x:Key="ModeValueTemplate" DataType="{x:Type contracts:SessionConfigValue}">
				<Grid>
					<Grid.ColumnDefinitions>
						<!--
							The icon column grows with the glyph it holds: pinned at 24px it clips that glyph
							once the chat font is raised (#22). Auto plus MinWidth rather than a scaled Width,
							because MinWidth takes the converter's double where Width needs a GridLength.
						-->
						<ColumnDefinition Width="Auto" MinWidth="{Binding ChatTextFontSize, RelativeSource={RelativeSource AncestorType=views:ChatPanelView}, Converter={StaticResource ChatTextFontSizeConverter}, ConverterParameter=24}" />
						<ColumnDefinition Width="*" />
						<ColumnDefinition Width="22" />
					</Grid.ColumnDefinitions>
					<TextBlock
						Grid.Column="0"
						Margin="0,2,0,0"
						VerticalAlignment="Top"
						FontFamily="Segoe MDL2 Assets"
						FontSize="{Binding ChatTextFontSize, RelativeSource={RelativeSource AncestorType=views:ChatPanelView}, Converter={StaticResource ChatTextFontSizeConverter}, ConverterParameter=14}"
						Foreground="{DynamicResource ChatSubtleForegroundBrush}"
						Text="{Binding Name, Converter={StaticResource SessionModeGlyphConverter}}" />
					<StackPanel Grid.Column="1">
						<TextBlock
							FontSize="{Binding ChatTextFontSize, RelativeSource={RelativeSource AncestorType=views:ChatPanelView}, Converter={StaticResource ChatTextFontSizeConverter}, ConverterParameter=13}"
							FontWeight="SemiBold"
							Text="{Binding Name}"
							TextWrapping="Wrap" />
						<TextBlock
							Margin="0,3,0,0"
							FontSize="{Binding ChatTextFontSize, RelativeSource={RelativeSource AncestorType=views:ChatPanelView}, Converter={StaticResource ChatTextFontSizeConverter}, ConverterParameter=11}"
							Foreground="{DynamicResource ChatSubtleForegroundBrush}"
							Text="{Binding Description}"
							TextWrapping="Wrap"
							Visibility="{Binding Description, Converter={StaticResource NullToVisibilityConverter}}" />
					</StackPanel>
					<Path
						Grid.Column="2"
						HorizontalAlignment="Right"
						VerticalAlignment="Center"
						Data="M 1,6 L 5,10 L 12,2"
						Stroke="{DynamicResource ChatAccentBrush}"
						StrokeThickness="1.6"
						Visibility="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}, Converter={StaticResource BoolToVisibilityConverter}}" />
				</Grid>
			</DataTemplate>
		</ResourceDictionary>
	</UserControl.Resources>

	<Grid>
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto" />
			<RowDefinition Height="*" />
			<RowDefinition Height="Auto" />
			<RowDefinition Height="Auto" />
			<RowDefinition Height="Auto" />
			<RowDefinition Height="Auto" />
		</Grid.RowDefinitions>

		<!--  Session header: usage panel, start a new chat, or reopen one from this workspace's history.  -->
		<Border
			Grid.Row="0"
			Padding="10,5,8,5"
			BorderBrush="{DynamicResource ChatBorderBrush}"
			BorderThickness="0,0,0,1">
			<Grid x:Name="HeaderBar">
				<Grid.ColumnDefinitions>
					<ColumnDefinition Width="*" />
					<ColumnDefinition Width="Auto" />
					<ColumnDefinition Width="Auto" />
					<ColumnDefinition Width="Auto" />
				</Grid.ColumnDefinitions>
				<TextBlock
					Grid.Column="0"
					Margin="0,0,8,0"
					VerticalAlignment="Center"
					AutomationProperties.Name="Session title"
					FontSize="{Binding ChatTextFontSize, ElementName=ChatPanel, Converter={StaticResource ChatTextFontSizeConverter}, ConverterParameter=13}"
					FontWeight="SemiBold"
					Foreground="{DynamicResource ChatForegroundBrush}"
					Text="{Binding SessionTitle}"
					TextTrimming="CharacterEllipsis"
					ToolTip="{Binding SessionTitle}" />
				<Button
					x:Name="UsageButton"
					Grid.Column="1"
					Width="{Binding ChatTextFontSize, ElementName=ChatPanel, Converter={StaticResource ChatTextFontSizeConverter}, ConverterParameter=28}"
					Height="{Binding ChatTextFontSize, ElementName=ChatPanel, Converter={StaticResource ChatTextFontSizeConverter}, ConverterParameter=28}"
					MinWidth="28"
					MinHeight="28"
					AutomationProperties.Name="Usage"
					Click="UsageButton_Click"
					Style="{StaticResource LinkButtonStyle}"
					ToolTip="Usage"
					Visibility="{Binding Usage, Converter={StaticResource NullToVisibilityConverter}}">
					<Grid Width="14" Height="14">
						<Path
							Data="M 1,12 A 6,6 0 0 1 13,12"
							StrokeThickness="1.3"
							Style="{StaticResource ButtonIconStrokeStyle}" />
						<Path
							Data="M 7,12 L 10,7"
							StrokeThickness="1.3"
							Style="{StaticResource ButtonIconStrokeStyle}" />
					</Grid>
				</Button>
				<Button
					x:Name="HistoryButton"
					Grid.Column="2"
					Width="{Binding ChatTextFontSize, ElementName=ChatPanel, Converter={StaticResource ChatTextFontSizeConverter}, ConverterParameter=28}"
					Height="{Binding ChatTextFontSize, ElementName=ChatPanel, Converter={StaticResource ChatTextFontSizeConverter}, ConverterParameter=28}"
					MinWidth="28"
					MinHeight="28"
					AutomationProperties.Name="Chat history"
					Click="HistoryButton_Click"
					Style="{StaticResource LinkButtonStyle}"
					ToolTip="Chat history">
					<Grid Width="14" Height="14">
						<Ellipse Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.3" />
						<Path
							Data="M 7,7 L 7,3 M 7,7 L 10,8.5"
							StrokeThickness="1.3"
							Style="{StaticResource ButtonIconStrokeStyle}" />
					</Grid>
				</Button>
				<Button
					Grid.Column="3"
					Width="{Binding ChatTextFontSize, ElementName=ChatPanel, Converter={StaticResource ChatTextFontSizeConverter}, ConverterParameter=28}"
					Height="{Binding ChatTextFontSize, ElementName=ChatPanel, Converter={StaticResource ChatTextFontSizeConverter}, ConverterParameter=28}"
					MinWidth="28"
					MinHeight="28"
					AutomationProperties.Name="New chat"
					Command="{Binding NewSessionCommand}"
					Style="{StaticResource LinkButtonStyle}"
					ToolTip="New chat">
					<Path
						Data="M 0,6 L 12,6 M 6,0 L 6,12"
						StrokeThickness="1.5"
						Style="{StaticResource ButtonIconStrokeStyle}" />
				</Button>
			</Grid>
		</Border>

		<!--
			Message history: rendered as HTML inside WebView2 (markdown-it + DOMPurify + highlight.js,
			see Resources\Transcript). Gives native text selection/copy across the whole transcript and
			real code-block syntax highlighting; ChatPanelView.xaml.cs pushes message data, theme colors
			and font size into the page and handles link-click messages coming back out.
		-->
		<wv2:WebView2
			x:Name="TranscriptView"
			Grid.Row="1"
			DefaultBackgroundColor="Transparent">
			<!--
				WebView2 is a native child HWND: it always paints on top of ordinary WPF content in the
				same window ("airspace"), so the empty-state placeholder below would never be visible
				behind it. Collapse the WebView2 itself instead whenever that placeholder should show.
			-->
			<wv2:WebView2.Style>
				<Style TargetType="wv2:WebView2">
					<Style.Triggers>
						<DataTrigger Binding="{Binding Messages.Count}" Value="0">
							<Setter Property="Visibility" Value="Collapsed" />
						</DataTrigger>
						<DataTrigger Binding="{Binding IsBusy}" Value="True">
							<Setter Property="Visibility" Value="Visible" />
						</DataTrigger>
					</Style.Triggers>
				</Style>
			</wv2:WebView2.Style>
		</wv2:WebView2>

		<StackPanel
			Grid.Row="1"
			Margin="24,20"
			VerticalAlignment="Center"
			IsHitTestVisible="False">
			<StackPanel.Style>
				<Style TargetType="StackPanel">
					<Setter Property="Visibility" Value="Collapsed" />
					<Style.Triggers>
						<DataTrigger Binding="{Binding Messages.Count}" Value="0">
							<Setter Property="Visibility" Value="Visible" />
						</DataTrigger>
						<DataTrigger Binding="{Binding IsBusy}" Value="True">
							<Setter Property="Visibility" Value="Collapsed" />
						</DataTrigger>
					</Style.Triggers>
				</Style>
			</StackPanel.Style>
			<StackPanel
				Margin="0,0,0,40"
				HorizontalAlignment="Center"
				Orientation="Horizontal">
				<!--
					The logo scales with the wordmark beside it: the two read as one lockup, and a bitmap
					resamples cleanly where the fixed-coordinate Path glyphs elsewhere would not.
				-->
				<Image
					Width="{Binding ChatTextFontSize, ElementName=ChatPanel, Converter={StaticResource ChatTextFontSizeConverter}, ConverterParameter=22}"
					Height="{Binding ChatTextFontSize, ElementName=ChatPanel, Converter={StaticResource ChatTextFontSizeConverter}, ConverterParameter=22}"
					Margin="0,0,6,0"
					VerticalAlignment="Center"
					AutomationProperties.Name="Claude Code"
					RenderOptions.BitmapScalingMode="HighQuality"
					Source="{DynamicResource ChatBrandImage}" />
				<TextBlock
					VerticalAlignment="Center"
					FontFamily="Georgia, Cambria"
					FontSize="{Binding ChatTextFontSize, ElementName=ChatPanel, Converter={StaticResource ChatTextFontSizeConverter}, ConverterParameter=24}"
					Text="Claude Code" />
			</StackPanel>
			<!--  LineHeight tracks the font size: pinned at 20 it crowds the two scaled lines together.  -->
			<TextBlock
				FontSize="{Binding ChatTextFontSize, ElementName=ChatPanel, Converter={StaticResource ChatTextFontSizeConverter}, ConverterParameter=13}"
				Foreground="{DynamicResource ChatSubtleForegroundBrush}"
				LineHeight="{Binding ChatTextFontSize, ElementName=ChatPanel, Converter={StaticResource ChatTextFontSizeConverter}, ConverterParameter=20}"
				Text="Ask a question, explore your solution,&#10;or make something great."
				TextAlignment="Center"
				TextWrapping="Wrap" />
		</StackPanel>

		<!--  Agent task list (plan) and the files the agent changed this session, above the composer.  -->
		<StackPanel Grid.Row="2">
			<Border
				Margin="12,6,12,0"
				Padding="10,6,10,6"
				Background="{DynamicResource ChatInputBackgroundBrush}"
				BorderBrush="{DynamicResource ChatBorderBrush}"
				BorderThickness="1"
				CornerRadius="12"
				DataContext="{Binding CurrentPlan}"
				Visibility="{Binding Converter={StaticResource NullToVisibilityConverter}}">
				<StackPanel>
					<ToggleButton
						AutomationProperties.Name="Tasks"
						IsChecked="{Binding IsExpanded}"
						Style="{StaticResource SectionToggleStyle}">
						<Grid>
							<Grid.ColumnDefinitions>
								<ColumnDefinition Width="Auto" />
								<ColumnDefinition Width="*" />
								<ColumnDefinition Width="Auto" />
							</Grid.ColumnDefinitions>
							<Path
								x:Name="TasksChevron"
								Grid.Column="0"
								Margin="2,0,8,0"
								VerticalAlignment="Center"
								Data="M 0,0 L 4,4 L 8,0"
								RenderTransformOrigin="0.5,0.5"
								Stroke="{DynamicResource ChatSubtleForegroundBrush}"
								StrokeThickness="1.3">
								<Path.Style>
									<Style TargetType="Path">
										<Style.Triggers>
											<DataTrigger Binding="{Binding IsExpanded}" Value="False">
												<Setter Property="RenderTransform">
													<Setter.Value>
														<RotateTransform Angle="-90" />
													</Setter.Value>
												</Setter>
											</DataTrigger>
										</Style.Triggers>
									</Style>
								</Path.Style>
							</Path>
							<TextBlock
								Grid.Column="1"
								VerticalAlignment="Center"
								FontSize="{Binding ChatTextFontSize, ElementName=ChatPanel, Converter={StaticResource ChatTextFontSizeConverter}, ConverterParameter=12}"
								FontWeight="SemiBold"
								Foreground="{DynamicResource ChatForegroundBrush}"
								Text="Tasks" />
							<TextBlock
								Grid.Column="2"
								VerticalAlignment="Center"
								FontSize="{Binding ChatTextFontSize, ElementName=ChatPanel, Converter={StaticResource ChatTextFontSizeConverter}, ConverterParameter=11}"
								Foreground="{DynamicResource ChatSubtleForegroundBrush}"
								Text="{Binding ProgressLabel}" />
						</Grid>
					</ToggleButton>
					<ItemsControl
						Margin="0,4,0,2"
						ItemsSource="{Binding Entries}"
						Visibility="{Binding IsExpanded, Converter={StaticResource BoolToVisibilityConverter}}">
						<ItemsControl.ItemTemplate>
							<DataTemplate DataType="{x:Type contracts:PlanEntry}">
								<Grid Margin="2,2">
									<Grid.ColumnDefinitions>
										<ColumnDefinition Width="Auto" />
										<ColumnDefinition Width="*" />
									</Grid.ColumnDefinitions>
									<TextBlock
										Margin="0,0,8,0"
										VerticalAlignment="Top"
										FontSize="{Binding ChatTextFontSize, RelativeSource={RelativeSource AncestorType=views:ChatPanelView}, Converter={StaticResource ChatTextFontSizeConverter}, ConverterParameter=12}"
										Foreground="{DynamicResource ChatSubtleForegroundBrush}"
										Text="{Binding Status, Converter={StaticResource PlanStatusGlyphConverter}}" />
									<TextBlock
										Grid.Column="1"
										FontSize="{Binding ChatTextFontSize, RelativeSource={RelativeSource AncestorType=views:ChatPanelView}, Converter={StaticResource ChatTextFontSizeConverter}, ConverterParameter=12}"
										Text="{Binding Content}"
										TextWrapping="Wrap">
										<TextBlock.Style>
											<Style TargetType="TextBlock">
												<Setter Property="Foreground" Value="{DynamicResource ChatForegroundBrush}" />
												<Style.Triggers>
													<DataTrigger Binding="{Binding Status}" Value="Completed">
														<Setter Property="Foreground" Value="{DynamicResource ChatSubtleForegroundBrush}" />
														<Setter Property="TextDecorations" Value="Strikethrough" />
													</DataTrigger>
													<DataTrigger Binding="{Binding Status}" Value="InProgress">
														<Setter Property="FontWeight" Value="SemiBold" />
													</DataTrigger>
												</Style.Triggers>
											</Style>
										</TextBlock.Style>
									</TextBlock>
								</Grid>
							</DataTemplate>
						</ItemsControl.ItemTemplate>
					</ItemsControl>
				</StackPanel>
			</Border>

			<Border
				Margin="12,6,12,0"
				Padding="10,6,10,6"
				Background="{DynamicResource ChatInputBackgroundBrush}"
				BorderBrush="{DynamicResource ChatBorderBrush}"
				BorderThickness="1"
				CornerRadius="12">
				<Border.Style>
					<Style TargetType="Border">
						<Style.Triggers>
							<DataTrigger Binding="{Binding ChangedFiles.Count}" Value="0">
								<Setter Property="Visibility" Value="Collapsed" />
							</DataTrigger>
						</Style.Triggers>
					</Style>
				</Border.Style>
				<StackPanel>
					<Grid Margin="2,2,0,2">
						<Grid.ColumnDefinitions>
							<ColumnDefinition Width="*" />
							<ColumnDefinition Width="Auto" />
							<ColumnDefinition Width="Auto" />
						</Grid.ColumnDefinitions>
						<TextBlock
							VerticalAlignment="Center"
							FontSize="{Binding ChatTextFontSize, RelativeSource={RelativeSource AncestorType=views:ChatPanelView}, Converter={StaticResource ChatTextFontSizeConverter}, ConverterParameter=12}"
							FontWeight="SemiBold"
							Foreground="{DynamicResource ChatForegroundBrush}">
							<Run Text="Changed files" /><Run Text=" · " /><Run Text="{Binding ChangedFiles.Count, Mode=OneWay}" />
						</TextBlock>
						<Button
							Grid.Column="1"
							Margin="0,0,4,0"
							Padding="8,3"
							AutomationProperties.Name="Reject all changes"
							Command="{Binding RejectAllChangesCommand}"
							Content="Reject all"
							FontSize="{Binding ChatTextFontSize, RelativeSource={RelativeSource AncestorType=views:ChatPanelView}, Converter={StaticResource ChatTextFontSizeConverter}, ConverterParameter=11}"
							Style="{StaticResource LinkButtonStyle}" />
						<Button
							Grid.Column="2"
							Padding="8,3"
							AutomationProperties.Name="Accept all changes"
							Command="{Binding AcceptAllChangesCommand}"
							Content="Accept all"
							FontSize="{Binding ChatTextFontSize, RelativeSource={RelativeSource AncestorType=views:ChatPanelView}, Converter={StaticResource ChatTextFontSizeConverter}, ConverterParameter=11}"
							Foreground="{DynamicResource ChatAccentBrush}"
							Style="{StaticResource LinkButtonStyle}" />
					</Grid>
					<!--
						The list's cap scales with its rows: pinned at 160px a raised chat font fits fewer
						files in the same box instead of showing the same files larger (#22).
					-->
					<ItemsControl MaxHeight="{Binding ChatTextFontSize, RelativeSource={RelativeSource AncestorType=views:ChatPanelView}, Converter={StaticResource ChatTextFontSizeConverter}, ConverterParameter=160}" ItemsSource="{Binding ChangedFiles}">
						<ItemsControl.Template>
							<ControlTemplate TargetType="ItemsControl">
								<ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
									<ItemsPresenter />
								</ScrollViewer>
							</ControlTemplate>
						</ItemsControl.Template>
						<ItemsControl.ItemTemplate>
							<DataTemplate DataType="{x:Type vm:ChangedFileViewModel}">
								<Grid Margin="0,1">
									<Grid.ColumnDefinitions>
										<ColumnDefinition Width="*" />
										<ColumnDefinition Width="Auto" />
										<ColumnDefinition Width="Auto" />
										<ColumnDefinition Width="Auto" />
										<ColumnDefinition Width="Auto" />
									</Grid.ColumnDefinitions>
									<Button
										Grid.Column="0"
										Padding="4,3"
										HorizontalContentAlignment="Left"
										AutomationProperties.Name="{Binding Name, StringFormat='Open {0}'}"
										Command="{Binding DataContext.OpenChangedFileCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
										CommandParameter="{Binding}"
										Foreground="{DynamicResource ChatForegroundBrush}"
										Style="{StaticResource LinkButtonStyle}"
										ToolTip="{Binding FullPath}">
										<StackPanel Orientation="Horizontal">
											<TextBlock
												Margin="0,0,7,0"
												VerticalAlignment="Center"
												FontFamily="Segoe MDL2 Assets"
												FontSize="{Binding ChatTextFontSize, RelativeSource={RelativeSource AncestorType=views:ChatPanelView}, Converter={StaticResource ChatTextFontSizeConverter}, ConverterParameter=11}"
												Foreground="{DynamicResource ChatSubtleForegroundBrush}"
												Text="&#xE8A5;" />
											<TextBlock
												VerticalAlignment="Center"
												FontSize="{Binding ChatTextFontSize, RelativeSource={RelativeSource AncestorType=views:ChatPanelView}, Converter={StaticResource ChatTextFontSizeConverter}, ConverterParameter=12}"
												Text="{Binding Name}"
												TextTrimming="CharacterEllipsis" />
											<TextBlock
												Margin="7,0,0,0"
												VerticalAlignment="Center"
												FontSize="{Binding ChatTextFontSize, RelativeSource={RelativeSource AncestorType=views:ChatPanelView}, Converter={StaticResource ChatTextFontSizeConverter}, ConverterParameter=10}"
												Foreground="{DynamicResource ChatSubtleForegroundBrush}"
												Text="new"
												Visibility="{Binding IsNew, Converter={StaticResource BoolToVisibilityConverter}}" />
										</StackPanel>
									</Button>
									<TextBlock
										Grid.Column="1"
										Margin="8,0,8,0"
										VerticalAlignment="Center"
										FontFamily="Consolas"
										FontSize="{Binding ChatTextFontSize, RelativeSource={RelativeSource AncestorType=views:ChatPanelView}, Converter={StaticResource ChatTextFontSizeConverter}, ConverterParameter=11}">
										<Run Foreground="{DynamicResource ChatDiffAddedForegroundBrush}" Text="{Binding AddedLines, Mode=OneWay, StringFormat='+{0}'}" />
										<Run Foreground="{DynamicResource ChatDiffRemovedForegroundBrush}" Text="{Binding RemovedLines, Mode=OneWay, StringFormat='−{0}'}" />
									</TextBlock>
									<!--
										Icon buttons scale up with the text but never below their default size: their
										glyph is fixed-coordinate Path data that would otherwise spill past the frame.
									-->
									<Button
										Grid.Column="2"
										Width="{Binding ChatTextFontSize, RelativeSource={RelativeSource AncestorType=views:ChatPanelView}, Converter={StaticResource ChatTextFontSizeConverter}, ConverterParameter=24}"
										Height="{Binding ChatTextFontSize, RelativeSource={RelativeSource AncestorType=views:ChatPanelView}, Converter={StaticResource ChatTextFontSizeConverter}, ConverterParameter=24}"
										MinWidth="24"
										MinHeight="24"
										AutomationProperties.Name="{Binding Name, StringFormat='Reject changes to {0}'}"
										Command="{Binding RejectCommand}"
										ToolTipService.ShowOnDisabled="True">
										<!--
											A row whose pre-edit content is unknown keeps a disabled reject button; its tooltip
											must say why rather than promise a restore that cannot happen.
										-->
										<Button.Style>
											<Style BasedOn="{StaticResource LinkButtonStyle}" TargetType="Button">
												<Setter Property="ToolTip" Value="Reject (restore original)" />
												<Style.Triggers>
													<DataTrigger Binding="{Binding CanRevert}" Value="False">
														<Setter Property="ToolTip" Value="Reject unavailable: the content from before the edit is not known" />
													</DataTrigger>
												</Style.Triggers>
											</Style>
										</Button.Style>
										<Path
											Data="M 0,0 L 8,8 M 0,8 L 8,0"
											StrokeThickness="1.4"
											Style="{StaticResource ButtonIconStrokeStyle}" />
									</Button>
									<!--
										The gap between Reject and Accept scales with the buttons so an accidental click
										between them stays as unlikely at every zoom level (#22).
									-->
									<Border Grid.Column="3" Width="{Binding ChatTextFontSize, RelativeSource={RelativeSource AncestorType=views:ChatPanelView}, Converter={StaticResource ChatTextFontSizeConverter}, ConverterParameter=10}" />
									<Button
										Grid.Column="4"
										Width="{Binding ChatTextFontSize, RelativeSource={RelativeSource AncestorType=views:ChatPanelView}, Converter={StaticResource ChatTextFontSizeConverter}, ConverterParameter=24}"
										Height="{Binding ChatTextFontSize, RelativeSource={RelativeSource AncestorType=views:ChatPanelView}, Converter={StaticResource ChatTextFontSizeConverter}, ConverterParameter=24}"
										MinWidth="24"
										MinHeight="24"
										AutomationProperties.Name="{Binding Name, StringFormat='Accept changes to {0}'}"
										Command="{Binding AcceptCommand}"
										Foreground="{DynamicResource ChatAccentBrush}"
										Style="{StaticResource LinkButtonStyle}"
										ToolTip="Accept (keep)">
										<Path
											Data="M 0,4 L 3.5,8 L 10,1"
											StrokeThickness="1.6"
											Style="{StaticResource ButtonIconStrokeStyle}" />
									</Button>
								</Grid>
							</DataTemplate>
						</ItemsControl.ItemTemplate>
					</ItemsControl>
				</StackPanel>
			</Border>
		</StackPanel>

		<StackPanel Grid.Row="3">
			<!--  Permission request card (card-style banners: same margins/radius as the composer, not full-width strips)  -->
			<Border
				Margin="12,6,12,0"
				Padding="12,10"
				Background="{DynamicResource ChatInputBackgroundBrush}"
				BorderBrush="{DynamicResource ChatAccentBrush}"
				BorderThickness="1"
				CornerRadius="12"
				DataContext="{Binding PendingPermission}"
				Visibility="{Binding Converter={StaticResource NullToVisibilityConverter}}">
				<StackPanel>
					<!--
						Title is agent-controlled (the tool name and its arguments), so it is bounded here as
						well as at ToolDisplayName.Describe: row 3 is Auto, and an Auto row takes its full
						desired height by collapsing the transcript's star row and pushing the composer past
						the panel's bottom edge. A ScrollViewer rather than TextTrimming - this is a consent
						surface, so the user must still be able to read every character of what they approve.
					-->
					<ScrollViewer
						MaxHeight="120"
						Margin="0,0,0,6"
						HorizontalScrollBarVisibility="Disabled"
						VerticalScrollBarVisibility="Auto">
						<TextBlock
							FontSize="{Binding ChatTextFontSize, ElementName=ChatPanel, Converter={StaticResource ChatTextFontSizeConverter}, ConverterParameter=12}"
							FontWeight="SemiBold"
							Foreground="{DynamicResource ChatForegroundBrush}"
							Text="{Binding Title}"
							TextWrapping="Wrap" />
					</ScrollViewer>
					<ItemsControl ItemsSource="{Binding Options}">
						<ItemsControl.ItemsPanel>
							<ItemsPanelTemplate>
								<StackPanel Orientation="Horizontal" />
							</ItemsPanelTemplate>
						</ItemsControl.ItemsPanel>
						<ItemsControl.ItemTemplate>
							<DataTemplate DataType="{x:Type contracts:PermissionOption}">
								<Button
									Margin="0,0,6,0"
									Command="{Binding DataContext.ChooseCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
									CommandParameter="{Binding}"
									Content="{Binding Label}"
									FontSize="{Binding ChatTextFontSize, RelativeSource={RelativeSource AncestorType=views:ChatPanelView}, Converter={StaticResource ChatTextFontSizeConverter}, ConverterParameter=12}"
									Style="{StaticResource ChatButtonStyle}" />
							</DataTemplate>
						</ItemsControl.ItemTemplate>
					</ItemsControl>
				</StackPanel>
			</Border>

			<!--
				Elicitation form card (the agent asking a structured question); same chrome family as the
				permission card above, which ElicitationCardView draws itself - no wrapper Border here or
				the frame would be doubled. Shares row 3 with the permission card rather than taking a row
				of its own, since both are transient request cards that sit directly above the composer.
			-->
			<views:ElicitationCardView DataContext="{Binding PendingElicitation}" Visibility="{Binding Converter={StaticResource NullToVisibilityConverter}}" />
		</StackPanel>

		<!--
			Usage limit warning banner: rounded top corners + the composer's own horizontal margin so
			it reads as attached to the composer card directly below it, not a separate full-width bar.
		-->
		<Border
			Grid.Row="4"
			Margin="12,8,12,0"
			Padding="12,8"
			Background="{DynamicResource ChatWarningBackgroundBrush}"
			BorderBrush="{DynamicResource ChatBorderBrush}"
			BorderThickness="1,1,1,0"
			CornerRadius="14,14,0,0"
			DataContext="{Binding UsageWarning}"
			Visibility="{Binding Converter={StaticResource NullToVisibilityConverter}}">
			<Grid>
				<Grid.ColumnDefinitions>
					<ColumnDefinition Width="*" />
					<ColumnDefinition Width="Auto" />
				</Grid.ColumnDefinitions>
				<TextBlock
					Grid.Column="0"
					VerticalAlignment="Center"
					FontSize="{Binding ChatTextFontSize, RelativeSource={RelativeSource AncestorType=views:ChatPanelView}, Converter={StaticResource ChatTextFontSizeConverter}, ConverterParameter=12}"
					Foreground="{DynamicResource ChatForegroundBrush}"
					TextWrapping="Wrap">
					<Run Text="{Binding Message, Mode=OneWay}" />
					<Hyperlink Click="UsageWarningLink_Click" Foreground="{DynamicResource ChatAccentBrush}">
						<Run Text="View usage" />
					</Hyperlink>
				</TextBlock>
				<Button
					Grid.Column="1"
					Width="24"
					Height="24"
					Margin="8,0,0,0"
					Padding="4"
					AutomationProperties.Name="Dismiss usage warning"
					Click="UsageWarningDismiss_Click"
					Style="{StaticResource LinkButtonStyle}"
					ToolTip="Dismiss">
					<Path
						Data="M 0,0 L 8,8 M 0,8 L 8,0"
						StrokeThickness="1.5"
						Style="{StaticResource ButtonIconStrokeStyle}" />
				</Button>
			</Grid>
		</Border>

		<!--  The input, attachments and controls are one integrated card.  -->
		<Grid Grid.Row="5">
			<Grid.Style>
				<Style TargetType="Grid">
					<!--
						Zero top margin when the usage banner is directly above so the two touch with no
						gap; the trigger restores normal breathing room for the (far more common) case
						where there's no banner and the composer needs its own spacing from row 4 above it.
					-->
					<Setter Property="Margin" Value="12,0,12,10" />
					<Style.Triggers>
						<DataTrigger Binding="{Binding UsageWarning}" Value="{x:Null}">
							<Setter Property="Margin" Value="12,8,12,10" />
						</DataTrigger>
					</Style.Triggers>
				</Style>
			</Grid.Style>
			<Grid.RowDefinitions>
				<RowDefinition Height="Auto" />
				<RowDefinition Height="Auto" />
				<RowDefinition Height="Auto" />
			</Grid.RowDefinitions>
			<StackPanel Grid.Row="0">
				<TextBlock
					Margin="3,0,3,8"
					AutomationProperties.LiveSetting="Polite"
					FontSize="{Binding ChatTextFontSize, ElementName=ChatPanel, Converter={StaticResource ChatTextFontSizeConverter}, ConverterParameter=11}"
					Foreground="{DynamicResource ChatSubtleForegroundBrush}"
					Text="{Binding StatusMessage}"
					TextWrapping="Wrap"
					Visibility="{Binding StatusMessage, Converter={StaticResource NullToVisibilityConverter}}" />
				<TextBlock
					x:Name="CopyFeedback"
					Margin="3,0,3,8"
					AutomationProperties.LiveSetting="Polite"
					FontSize="{Binding ChatTextFontSize, ElementName=ChatPanel, Converter={StaticResource ChatTextFontSizeConverter}, ConverterParameter=11}"
					Foreground="{DynamicResource ChatSubtleForegroundBrush}"
					TextWrapping="Wrap"
					Visibility="Collapsed" />
				<!--
					Informational only: the composer below stays visible and usable while signed out too,
					since typing /login there is how this hint is meant to be acted on.
				-->
				<StackPanel Margin="4,0,4,8" Visibility="{Binding NeedsAuthentication, Converter={StaticResource BoolToVisibilityConverter}}">
					<TextBlock
						Margin="0,0,0,10"
						Text="Use your Claude Code sign-in to start chatting, or type /login below."
						TextWrapping="Wrap" />
					<Button
						HorizontalAlignment="Left"
						Command="{Binding SignInCommand}"
						Content="Check CLI sign-in"
						Style="{StaticResource ChatButtonStyle}" />
				</StackPanel>
			</StackPanel>

			<!--
				Composer: one rounded, focus-highlighted box holding the text area and, under a hairline,
				the toolbar - like the VS Code extension. Always visible, including while signed out,
				so /login (the way to get out of that state) is always reachable.
			-->
			<Grid x:Name="ComposerCard" Grid.Row="1">
				<Grid.RowDefinitions>
					<RowDefinition Height="Auto" />
					<RowDefinition Height="Auto" />
				</Grid.RowDefinitions>
				<Border
					x:Name="ComposerBox_Frame"
					Grid.Row="0"
					Background="{DynamicResource ChatInputBackgroundBrush}"
					BorderThickness="1">
					<Border.Style>
						<Style TargetType="Border">
							<Setter Property="BorderBrush" Value="{DynamicResource ChatBorderBrush}" />
							<!--
								Default assumes the usage warning banner is showing directly above (flattened top
								corners, so the two read as one attached shape); the trigger below restores full
								rounding for the (far more common) case where there's no banner. DataTrigger can only
								compare for equality, so "banner present" has to be the unconditional default and
								"no banner" the one explicit Value="{x:Null}" case, not the other way around.
							-->
							<Setter Property="CornerRadius" Value="0,0,16,16" />
							<Style.Triggers>
								<DataTrigger Binding="{Binding IsKeyboardFocusWithin, ElementName=ComposerBox}" Value="True">
									<Setter Property="BorderBrush" Value="{DynamicResource ChatFocusBrush}" />
								</DataTrigger>
								<DataTrigger Binding="{Binding UsageWarning}" Value="{x:Null}">
									<Setter Property="CornerRadius" Value="16" />
								</DataTrigger>
							</Style.Triggers>
						</Style>
					</Border.Style>
					<Grid>
						<Grid.RowDefinitions>
							<RowDefinition Height="Auto" />
							<RowDefinition Height="Auto" />
							<RowDefinition Height="Auto" />
						</Grid.RowDefinitions>
						<Grid Margin="12,9,12,7">
							<Grid.RowDefinitions>
								<RowDefinition Height="Auto" />
								<RowDefinition Height="Auto" />
								<RowDefinition Height="Auto" />
							</Grid.RowDefinitions>

							<Grid Grid.Row="1" Margin="3,0,3,0">
								<!--  No MinHeight: one line tall initially, grows with the text up to MaxHeight (VS Code behavior).  -->
								<TextBox
									x:Name="ComposerBox"
									MaxHeight="220"
									Padding="3"
									VerticalAlignment="Center"
									AcceptsReturn="True"
									AcceptsTab="False"
									AutomationProperties.HelpText="Enter to send. Shift+Enter for a new line. Type slash for session commands; arrows select, Tab or Enter inserts, Escape dismisses. Paste text or an image with Ctrl+V."
									AutomationProperties.Name="Message Claude"
									Background="Transparent"
									BorderThickness="0"
									CaretBrush="{DynamicResource ChatForegroundBrush}"
									FontSize="{Binding ChatTextFontSize, ElementName=ChatPanel}"
									Foreground="{DynamicResource ChatForegroundBrush}"
									HorizontalScrollBarVisibility="Disabled"
									PreviewKeyDown="ComposerBox_PreviewKeyDown"
									SelectionBrush="{DynamicResource ChatSelectionBrush}"
									SelectionChanged="ComposerBox_SelectionChanged"
									Style="{StaticResource ComposerStyle}"
									TargetUpdated="ComposerBox_TargetUpdated"
									Text="{Binding InputText, UpdateSourceTrigger=PropertyChanged, NotifyOnTargetUpdated=True}"
									TextWrapping="Wrap"
									VerticalScrollBarVisibility="Auto">
									<TextBox.Template>
										<ControlTemplate TargetType="TextBox">
											<ScrollViewer
												x:Name="PART_ContentHost"
												Margin="{TemplateBinding Padding}"
												Background="{TemplateBinding Background}" />
										</ControlTemplate>
									</TextBox.Template>
								</TextBox>
								<TextBlock
									Margin="5,0,5,0"
									VerticalAlignment="Center"
									FontSize="{Binding ChatTextFontSize, ElementName=ChatPanel}"
									Foreground="{DynamicResource ChatSubtleForegroundBrush}"
									IsHitTestVisible="False"
									TextWrapping="Wrap">
									<TextBlock.Style>
										<Style TargetType="TextBlock">
											<Setter Property="Visibility" Value="Collapsed" />
											<Setter Property="Text" Value="Type / for commands" />
											<Style.Triggers>
												<DataTrigger Binding="{Binding Text.Length, ElementName=ComposerBox}" Value="0">
													<Setter Property="Visibility" Value="Visible" />
												</DataTrigger>
												<!--  While Claude works, what is typed here is queued for it (see ChatViewModel.EnqueueDraft).  -->
												<DataTrigger Binding="{Binding IsBusy}" Value="True">
													<Setter Property="Text" Value="Queue another message" />
												</DataTrigger>
											</Style.Triggers>
										</Style>
									</TextBlock.Style>
								</TextBlock>
							</Grid>

							<ItemsControl
								Grid.Row="0"
								Margin="2,0,2,0"
								ItemsSource="{Binding Attachments}"
								Style="{StaticResource DraftControlStyle}">
								<ItemsControl.ItemsPanel>
									<ItemsPanelTemplate>
										<WrapPanel />
									</ItemsPanelTemplate>
								</ItemsControl.ItemsPanel>
								<ItemsControl.ItemTemplate>
									<DataTemplate>
										<Grid Margin="0,0,6,6">
											<!--  Document snapshot: name chip.  -->
											<Border
												Padding="8,4,3,4"
												Background="{DynamicResource ChatBackgroundBrush}"
												BorderBrush="{DynamicResource ChatBorderBrush}"
												BorderThickness="1"
												CornerRadius="8"
												Visibility="{Binding IsDocument, Converter={StaticResource BoolToVisibilityConverter}}">
												<StackPanel Orientation="Horizontal">
													<TextBlock
														Margin="0,0,6,0"
														VerticalAlignment="Center"
														AutomationProperties.Name="Document snapshot"
														FontFamily="Segoe MDL2 Assets"
														FontSize="{Binding ChatTextFontSize, RelativeSource={RelativeSource AncestorType=views:ChatPanelView}, Converter={StaticResource ChatTextFontSizeConverter}, ConverterParameter=12}"
														Text="&#xE8A5;" />
													<TextBlock
														MaxWidth="{Binding ChatTextFontSize, RelativeSource={RelativeSource AncestorType=views:ChatPanelView}, Converter={StaticResource ChatTextFontSizeConverter}, ConverterParameter=125}"
														VerticalAlignment="Center"
														FontSize="{Binding ChatTextFontSize, RelativeSource={RelativeSource AncestorType=views:ChatPanelView}, Converter={StaticResource ChatTextFontSizeConverter}, ConverterParameter=11}"
														Text="{Binding Name}"
														TextTrimming="CharacterEllipsis"
														ToolTip="{Binding Name}" />
													<Button
														Width="{Binding ChatTextFontSize, RelativeSource={RelativeSource AncestorType=views:ChatPanelView}, Converter={StaticResource ChatTextFontSizeConverter}, ConverterParameter=26}"
														Height="{Binding ChatTextFontSize, RelativeSource={RelativeSource AncestorType=views:ChatPanelView}, Converter={StaticResource ChatTextFontSizeConverter}, ConverterParameter=26}"
														MinWidth="26"
														MinHeight="26"
														AutomationProperties.Name="{Binding Name, StringFormat='Remove attachment {0}'}"
														Command="{Binding DataContext.RemoveAttachmentCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
														CommandParameter="{Binding}"
														Content="&#xE711;"
														FontFamily="Segoe MDL2 Assets"
														FontSize="{Binding ChatTextFontSize, RelativeSource={RelativeSource AncestorType=views:ChatPanelView}, Converter={StaticResource ChatTextFontSizeConverter}, ConverterParameter=9}"
														Style="{StaticResource LinkButtonStyle}"
														ToolTip="{Binding Name, StringFormat='Remove attachment {0}'}" />
												</StackPanel>
											</Border>
											<!--  Image (pasted or attached): thumbnail with a remove button in the corner.  -->
											<Grid ToolTip="{Binding Name}" Visibility="{Binding IsImage, Converter={StaticResource BoolToVisibilityConverter}}">
												<Border
													Width="88"
													Height="64"
													Background="{DynamicResource ChatBackgroundBrush}"
													BorderBrush="{DynamicResource ChatBorderBrush}"
													BorderThickness="1"
													CornerRadius="8">
													<Border.Clip>
														<RectangleGeometry
															RadiusX="8"
															RadiusY="8"
															Rect="0,0,88,64" />
													</Border.Clip>
													<Grid>
														<!--
															Not chat text, and the only FontSize here that does not follow the chat
															font: it is a stand-in for the thumbnail itself, centered in a frame
															whose 88x64 size and Clip geometry are fixed, so a scaled glyph would
															only be cropped by that clip.
														-->
														<TextBlock
															HorizontalAlignment="Center"
															VerticalAlignment="Center"
															FontFamily="Segoe MDL2 Assets"
															FontSize="20"
															Foreground="{DynamicResource ChatSubtleForegroundBrush}"
															Text="&#xE91B;" />
														<Image
															AutomationProperties.Name="{Binding Name}"
															RenderOptions.BitmapScalingMode="HighQuality"
															Source="{Binding Base64Data, Converter={StaticResource Base64ToImageSourceConverter}}"
															Stretch="UniformToFill" />
													</Grid>
												</Border>
												<Button
													Width="{Binding ChatTextFontSize, RelativeSource={RelativeSource AncestorType=views:ChatPanelView}, Converter={StaticResource ChatTextFontSizeConverter}, ConverterParameter=20}"
													Height="{Binding ChatTextFontSize, RelativeSource={RelativeSource AncestorType=views:ChatPanelView}, Converter={StaticResource ChatTextFontSizeConverter}, ConverterParameter=20}"
													MinWidth="20"
													MinHeight="20"
													Margin="0,3,3,0"
													Padding="0"
													HorizontalAlignment="Right"
													VerticalAlignment="Top"
													AutomationProperties.Name="{Binding Name, StringFormat='Remove image {0}'}"
													Background="{DynamicResource ChatPopupBackgroundBrush}"
													Command="{Binding DataContext.RemoveAttachmentCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
													CommandParameter="{Binding}"
													Content="&#xE711;"
													FontFamily="Segoe MDL2 Assets"
													FontSize="{Binding ChatTextFontSize, RelativeSource={RelativeSource AncestorType=views:ChatPanelView}, Converter={StaticResource ChatTextFontSizeConverter}, ConverterParameter=8}"
													Foreground="{DynamicResource ChatForegroundBrush}"
													Style="{StaticResource LinkButtonStyle}"
													ToolTip="{Binding Name, StringFormat='Remove image {0}'}" />
											</Grid>
										</Grid>
									</DataTemplate>
								</ItemsControl.ItemTemplate>
							</ItemsControl>

							<Grid
								Grid.Row="2"
								Margin="4,0,0,6"
								Visibility="{Binding AttachmentError, Converter={StaticResource NullToVisibilityConverter}}">
								<Grid.ColumnDefinitions>
									<ColumnDefinition Width="*" />
									<ColumnDefinition Width="Auto" />
								</Grid.ColumnDefinitions>
								<TextBlock
									VerticalAlignment="Center"
									AutomationProperties.LiveSetting="Polite"
									FontSize="{Binding ChatTextFontSize, ElementName=ChatPanel, Converter={StaticResource ChatTextFontSizeConverter}, ConverterParameter=11}"
									Foreground="{DynamicResource ChatSubtleForegroundBrush}"
									Text="{Binding AttachmentError}"
									TextWrapping="Wrap" />
								<Button
									Grid.Column="1"
									Width="{Binding ChatTextFontSize, ElementName=ChatPanel, Converter={StaticResource ChatTextFontSizeConverter}, ConverterParameter=22}"
									Height="{Binding ChatTextFontSize, ElementName=ChatPanel, Converter={StaticResource ChatTextFontSizeConverter}, ConverterParameter=22}"
									MinWidth="22"
									MinHeight="22"
									Margin="6,0,0,0"
									Padding="4"
									AutomationProperties.Name="Dismiss attachment message"
									Click="AttachmentErrorDismiss_Click"
									Style="{StaticResource LinkButtonStyle}"
									ToolTip="Dismiss">
									<Path
										Data="M 0,0 L 7,7 M 0,7 L 7,0"
										StrokeThickness="1.3"
										Style="{StaticResource ButtonIconStrokeStyle}" />
								</Button>
							</Grid>
						</Grid>
						<!--
							The toolbar lives in the same rounded container as the text, under a hairline, like the
							VS Code extension - one box that scales as a unit.
						-->
						<Border
							Grid.Row="1"
							Height="1"
							Background="{DynamicResource ChatBorderBrush}"
							Opacity="0.6" />
						<Grid Grid.Row="2" Margin="6,3,6,3">
							<Grid.ColumnDefinitions>
								<ColumnDefinition Width="*" />
								<ColumnDefinition Width="Auto" />
							</Grid.ColumnDefinitions>
							<!--
								DockPanel (not StackPanel): the model pill is the last child, so it gets the remaining
								width and its text trims instead of pushing the mode/send buttons out of the panel
								when the tool window is narrow.
							-->
							<ContentControl
								Grid.Column="0"
								Margin="0,0,6,0"
								Focusable="False">
								<DockPanel LastChildFill="True">
									<!--
										Only the draft-composition buttons are disabled mid-turn. IsEnabled is inherited
										in WPF, so this wrapper must never enclose the mode/model/Remote Control pills:
										a disabled ancestor wins over their own IsEnabled="{Binding CanConfigure}" and
										they would be unusable while Claude works, which is exactly when switching mode
										or model matters. CanConfigure deliberately ignores IsBusy for the same reason.
									-->
									<ContentControl Focusable="False" Style="{StaticResource DraftControlStyle}">
										<StackPanel Orientation="Horizontal">
											<Button
												x:Name="AttachButton"
												Width="{Binding ChatTextFontSize, ElementName=ChatPanel, Converter={StaticResource ChatTextFontSizeConverter}, ConverterParameter=32}"
												Height="{Binding ChatTextFontSize, ElementName=ChatPanel, Converter={StaticResource ChatTextFontSizeConverter}, ConverterParameter=32}"
												MinWidth="32"
												MinHeight="32"
												AutomationProperties.HelpText="Captures the current editor text now. Attach documents from multiple tabs before sending."
												AutomationProperties.Name="Attach active Visual Studio document"
												Command="{Binding AttachActiveDocumentCommand}"
												Style="{StaticResource LinkButtonStyle}"
												ToolTipService.ShowOnDisabled="True">
												<Button.ToolTip>
													<ToolTip>
														<TextBlock>
															<TextBlock.Style>
																<Style TargetType="TextBlock">
																	<Setter Property="Text" Value="Attach active Visual Studio document (including unsaved edits)" />
																	<Style.Triggers>
																		<DataTrigger Binding="{Binding HasActiveDocument}" Value="False">
																			<Setter Property="Text" Value="Open a text document in the editor to attach it" />
																		</DataTrigger>
																	</Style.Triggers>
																</Style>
															</TextBlock.Style>
														</TextBlock>
													</ToolTip>
												</Button.ToolTip>
												<Viewbox Width="{Binding ChatTextFontSize, ElementName=ChatPanel, Converter={StaticResource ChatTextFontSizeConverter}, ConverterParameter=15}" Height="{Binding ChatTextFontSize, ElementName=ChatPanel, Converter={StaticResource ChatTextFontSizeConverter}, ConverterParameter=15}">
													<Path
														Data="M 0,7 L 14,7 M 7,0 L 7,14"
														StrokeThickness="1.6"
														Style="{StaticResource ButtonIconStrokeStyle}" />
												</Viewbox>
											</Button>
											<Button
												Width="{Binding ChatTextFontSize, ElementName=ChatPanel, Converter={StaticResource ChatTextFontSizeConverter}, ConverterParameter=32}"
												Height="{Binding ChatTextFontSize, ElementName=ChatPanel, Converter={StaticResource ChatTextFontSizeConverter}, ConverterParameter=32}"
												MinWidth="32"
												MinHeight="32"
												AutomationProperties.Name="Session commands"
												Click="SlashButton_Click"
												Style="{StaticResource LinkButtonStyle}"
												ToolTip="Session commands (/)">
												<Viewbox Width="{Binding ChatTextFontSize, ElementName=ChatPanel, Converter={StaticResource ChatTextFontSizeConverter}, ConverterParameter=15}" Height="{Binding ChatTextFontSize, ElementName=ChatPanel, Converter={StaticResource ChatTextFontSizeConverter}, ConverterParameter=15}">
													<Border
														Width="16"
														Height="16"
														BorderBrush="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
														BorderThickness="1.3"
														CornerRadius="3">
														<Path
															HorizontalAlignment="Center"
															VerticalAlignment="Center"
															Data="M 4,11 L 8,2"
															StrokeThickness="1.3"
															Style="{StaticResource ButtonIconStrokeStyle}" />
													</Border>
												</Viewbox>
											</Button>
											<Button
												Width="{Binding ChatTextFontSize, ElementName=ChatPanel, Converter={StaticResource ChatTextFontSizeConverter}, ConverterParameter=32}"
												Height="{Binding ChatTextFontSize, ElementName=ChatPanel, Converter={StaticResource ChatTextFontSizeConverter}, ConverterParameter=32}"
												MinWidth="32"
												MinHeight="32"
												AutomationProperties.Name="Attach image file"
												Click="AttachImageButton_Click"
												Style="{StaticResource LinkButtonStyle}"
												ToolTip="Attach an image file (or paste with Ctrl+V)">
												<TextBlock
													FontFamily="Segoe MDL2 Assets"
													FontSize="{Binding ChatTextFontSize, ElementName=ChatPanel, Converter={StaticResource ChatTextFontSizeConverter}, ConverterParameter=14}"
													Text="&#xE91B;" />
											</Button>
										</StackPanel>
									</ContentControl>
									<!--  Context-window fill ring (hover for exact numbers).  -->
									<Grid
										Width="16"
										Height="16"
										Margin="6,0,6,0"
										VerticalAlignment="Center"
										AutomationProperties.Name="{Binding ContextUsageLabel}"
										DockPanel.Dock="Left"
										ToolTip="{Binding ContextUsageLabel}"
										Visibility="{Binding ContextUsagePercent, Converter={StaticResource NullToVisibilityConverter}}">
										<Ellipse Stroke="{DynamicResource ChatBorderBrush}" StrokeThickness="2" />
										<Ellipse
											RenderTransformOrigin="0.5,0.5"
											Stroke="{DynamicResource ChatAccentBrush}"
											StrokeDashArray="{Binding ContextUsagePercent, Converter={StaticResource PercentToDashArrayConverter}, ConverterParameter=7\,2}"
											StrokeThickness="2">
											<Ellipse.RenderTransform>
												<RotateTransform Angle="-90" />
											</Ellipse.RenderTransform>
										</Ellipse>
									</Grid>
									<!--
										Remote Control pill: blue while the session can be driven from claude.ai/code.
										No Visibility binding: session modes (HasModes) are an unrelated capability, and
										the view model exposes no remote-control capability flag, so let
										ToggleRemoteControlCommand.CanExecute disable the pill instead of hiding it.
									-->
									<Button
										x:Name="RemoteControlButton"
										Height="{Binding ChatTextFontSize, ElementName=ChatPanel, Converter={StaticResource ChatTextFontSizeConverter}, ConverterParameter=24}"
										Margin="4,0,0,0"
										Padding="8,0"
										VerticalAlignment="Center"
										AutomationProperties.Name="Remote Control"
										Command="{Binding ToggleRemoteControlCommand}"
										ToolTipService.ShowOnDisabled="True">
										<Button.Style>
											<Style BasedOn="{StaticResource LinkButtonStyle}" TargetType="Button">
												<Setter Property="BorderBrush" Value="Transparent" />
												<Setter Property="ToolTip" Value="Turn on Remote Control to drive this session from claude.ai/code" />
												<Style.Triggers>
													<DataTrigger Binding="{Binding IsRemoteControlEnabled}" Value="True">
														<Setter Property="Background" Value="{DynamicResource ChatRemoteControlBrush}" />
														<Setter Property="Foreground" Value="White" />
														<Setter Property="ToolTip" Value="Remote Control is active · click to turn off" />
													</DataTrigger>
													<DataTrigger Binding="{Binding IsRemoteControlBusy}" Value="True">
														<Setter Property="Opacity" Value="0.6" />
													</DataTrigger>
												</Style.Triggers>
											</Style>
										</Button.Style>
										<StackPanel Orientation="Horizontal">
											<TextBlock
												Margin="0,0,6,0"
												VerticalAlignment="Center"
												FontFamily="Segoe MDL2 Assets"
												FontSize="{Binding ChatTextFontSize, ElementName=ChatPanel, Converter={StaticResource ChatTextFontSizeConverter}, ConverterParameter=12}"
												Text="&#xE774;" />
											<TextBlock
												VerticalAlignment="Center"
												FontSize="{Binding ChatTextFontSize, ElementName=ChatPanel, Converter={StaticResource ChatTextFontSizeConverter}, ConverterParameter=12}"
												Text="Remote Control" />
										</StackPanel>
									</Button>
									<Button
										Width="{Binding ChatTextFontSize, ElementName=ChatPanel, Converter={StaticResource ChatTextFontSizeConverter}, ConverterParameter=26}"
										Height="{Binding ChatTextFontSize, ElementName=ChatPanel, Converter={StaticResource ChatTextFontSizeConverter}, ConverterParameter=26}"
										MinWidth="26"
										MinHeight="26"
										AutomationProperties.Name="Open this session on claude.ai/code"
										Click="RemoteControlLink_Click"
										Style="{StaticResource LinkButtonStyle}"
										ToolTip="{Binding RemoteControlUrl}"
										Visibility="{Binding RemoteControlUrl, Converter={StaticResource NullToVisibilityConverter}}">
										<TextBlock
											FontFamily="Segoe MDL2 Assets"
											FontSize="{Binding ChatTextFontSize, ElementName=ChatPanel, Converter={StaticResource ChatTextFontSizeConverter}, ConverterParameter=11}"
											Text="&#xE8A7;" />
									</Button>
									<!--  Running subagents (Claude Code's Agent tool), like the VS Code extension's pill.  -->
									<Border
										Height="{Binding ChatTextFontSize, ElementName=ChatPanel, Converter={StaticResource ChatTextFontSizeConverter}, ConverterParameter=24}"
										Margin="4,0,0,0"
										Padding="8,0"
										VerticalAlignment="Center"
										AutomationProperties.Name="Running agents"
										Background="{DynamicResource ChatHoverBrush}"
										CornerRadius="8"
										ToolTip="Subagents running in this session">
										<StackPanel Orientation="Horizontal">
											<Ellipse
												Width="6"
												Height="6"
												Margin="0,0,6,0"
												VerticalAlignment="Center">
												<Ellipse.Style>
													<Style TargetType="Ellipse">
														<Setter Property="Fill" Value="{DynamicResource ChatSubtleForegroundBrush}" />
														<Style.Triggers>
															<DataTrigger Binding="{Binding RunningAgentCount}" Value="0">
																<Setter Property="Opacity" Value="0.6" />
															</DataTrigger>
														</Style.Triggers>
													</Style>
												</Ellipse.Style>
											</Ellipse>
											<TextBlock
												VerticalAlignment="Center"
												FontSize="{Binding ChatTextFontSize, ElementName=ChatPanel, Converter={StaticResource ChatTextFontSizeConverter}, ConverterParameter=12}"
												Foreground="{DynamicResource ChatForegroundBrush}"
												Text="{Binding RunningAgentsLabel}" />
										</StackPanel>
									</Border>
									<Button
										x:Name="ModelButton"
										Height="{Binding ChatTextFontSize, ElementName=ChatPanel, Converter={StaticResource ChatTextFontSizeConverter}, ConverterParameter=24}"
										MaxWidth="{Binding ChatTextFontSize, ElementName=ChatPanel, Converter={StaticResource ChatTextFontSizeConverter}, ConverterParameter=280}"
										Margin="4,0,0,0"
										Padding="8,0"
										HorizontalAlignment="Left"
										VerticalAlignment="Center"
										AutomationProperties.HelpText="Choose the model and reasoning effort for this conversation."
										AutomationProperties.Name="Model and effort"
										Background="Transparent"
										BorderBrush="Transparent"
										Click="ModelButton_Click"
										Foreground="{DynamicResource ChatForegroundBrush}"
										IsEnabled="{Binding CanConfigure}"
										Style="{StaticResource LinkButtonStyle}"
										ToolTip="Choose model and effort"
										ToolTipService.ShowOnDisabled="True">
										<Grid>
											<Grid.ColumnDefinitions>
												<ColumnDefinition Width="*" />
												<ColumnDefinition Width="Auto" />
												<ColumnDefinition Width="Auto" />
											</Grid.ColumnDefinitions>
											<TextBlock
												Grid.ColumnSpan="2"
												VerticalAlignment="Center"
												FontSize="{Binding ChatTextFontSize, ElementName=ChatPanel, Converter={StaticResource ChatTextFontSizeConverter}, ConverterParameter=12}"
												Text="{Binding ModelEffortLabel}"
												TextTrimming="CharacterEllipsis" />
											<Path
												Grid.Column="2"
												Margin="7,0,0,2"
												VerticalAlignment="Center"
												Data="M 0,0 L 4,4 L 8,0"
												StrokeThickness="1.3"
												Style="{StaticResource ButtonIconStrokeStyle}" />
										</Grid>
									</Button>
								</DockPanel>
							</ContentControl>
							<!--
								Right end, like the VS Code extension: session mode, then Stop/Send, which scale with the
								chat font like the rest of the toolbar (owner decision, replacing #22). Send stays enabled while busy:
								sending then queues the message (see ChatViewModel.SendCoreAsync), so Stop sits
								alongside it rather than replacing it.
							-->
							<StackPanel
								Grid.Column="1"
								VerticalAlignment="Center"
								Orientation="Horizontal">
								<!--
									MaxWidth scales with the label it caps: pinned it would trim the mode name to
									ellipsis at the very font size the user raised to read it (#22).
								-->
								<Button
									x:Name="ModeButton"
									MaxWidth="{Binding ChatTextFontSize, ElementName=ChatPanel, Converter={StaticResource ChatTextFontSizeConverter}, ConverterParameter=180}"
									Margin="0,0,4,0"
									Padding="6,5"
									AutomationProperties.HelpText="Choose how Claude asks for permission in this conversation."
									AutomationProperties.Name="Session mode"
									Background="Transparent"
									BorderBrush="Transparent"
									Click="ModeButton_Click"
									Foreground="{DynamicResource ChatForegroundBrush}"
									IsEnabled="{Binding CanConfigure}"
									Style="{StaticResource LinkButtonStyle}"
									ToolTip="Choose session mode"
									ToolTipService.ShowOnDisabled="True"
									Visibility="{Binding HasModes, Converter={StaticResource BoolToVisibilityConverter}}">
									<StackPanel Orientation="Horizontal">
										<TextBlock
											Margin="0,0,6,0"
											VerticalAlignment="Center"
											FontFamily="Segoe MDL2 Assets"
											FontSize="{Binding ChatTextFontSize, ElementName=ChatPanel, Converter={StaticResource ChatTextFontSizeConverter}, ConverterParameter=13}"
											Text="{Binding ActiveModeName, Converter={StaticResource SessionModeGlyphConverter}}" />
										<TextBlock
											VerticalAlignment="Center"
											FontSize="{Binding ChatTextFontSize, ElementName=ChatPanel, Converter={StaticResource ChatTextFontSizeConverter}, ConverterParameter=12}"
											Text="{Binding ActiveModeName}"
											TextTrimming="CharacterEllipsis" />
										<Path
											Margin="6,2,0,0"
											VerticalAlignment="Center"
											Data="M 0,0 L 4,4 L 8,0"
											StrokeThickness="1.3"
											Style="{StaticResource ButtonIconStrokeStyle}" />
									</StackPanel>
								</Button>
								<Button
									Width="{Binding ChatTextFontSize, ElementName=ChatPanel, Converter={StaticResource ChatTextFontSizeConverter}, ConverterParameter=28}"
									Height="{Binding ChatTextFontSize, ElementName=ChatPanel, Converter={StaticResource ChatTextFontSizeConverter}, ConverterParameter=28}"
									Margin="0,0,4,0"
									Padding="0"
									AutomationProperties.Name="Cancel sign-in or sign-out"
									Command="{Binding CancelAuthCommand}"
									Style="{StaticResource ChatButtonStyle}"
									ToolTip="Cancel sign-in or sign-out"
									Visibility="{Binding IsAuthCommandRunning, Converter={StaticResource BoolToVisibilityConverter}}">
									<Viewbox Width="{Binding ChatTextFontSize, ElementName=ChatPanel, Converter={StaticResource ChatTextFontSizeConverter}, ConverterParameter=10}" Height="{Binding ChatTextFontSize, ElementName=ChatPanel, Converter={StaticResource ChatTextFontSizeConverter}, ConverterParameter=10}">
										<Rectangle
											Width="10"
											Height="10"
											Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
											RadiusX="1.5"
											RadiusY="1.5" />
									</Viewbox>
								</Button>
								<Button
									Width="{Binding ChatTextFontSize, ElementName=ChatPanel, Converter={StaticResource ChatTextFontSizeConverter}, ConverterParameter=28}"
									Height="{Binding ChatTextFontSize, ElementName=ChatPanel, Converter={StaticResource ChatTextFontSizeConverter}, ConverterParameter=28}"
									Margin="0,0,4,0"
									Padding="0"
									AutomationProperties.Name="Stop response"
									Command="{Binding CancelCommand}"
									Style="{StaticResource ChatButtonStyle}"
									ToolTip="Stop response (Esc)"
									Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibilityConverter}}">
									<Viewbox Width="{Binding ChatTextFontSize, ElementName=ChatPanel, Converter={StaticResource ChatTextFontSizeConverter}, ConverterParameter=10}" Height="{Binding ChatTextFontSize, ElementName=ChatPanel, Converter={StaticResource ChatTextFontSizeConverter}, ConverterParameter=10}">
										<Rectangle
											Width="10"
											Height="10"
											Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
											RadiusX="1.5"
											RadiusY="1.5" />
									</Viewbox>
								</Button>
								<Button
									Width="{Binding ChatTextFontSize, ElementName=ChatPanel, Converter={StaticResource ChatTextFontSizeConverter}, ConverterParameter=28}"
									Height="{Binding ChatTextFontSize, ElementName=ChatPanel, Converter={StaticResource ChatTextFontSizeConverter}, ConverterParameter=28}"
									Padding="0"
									AutomationProperties.Name="Send message"
									Click="SendButton_Click"
									Command="{Binding SendCommand}"
									Style="{StaticResource ChatButtonStyle}"
									ToolTip="Send message (Enter)"
									Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Invert}">
									<Viewbox Width="{Binding ChatTextFontSize, ElementName=ChatPanel, Converter={StaticResource ChatTextFontSizeConverter}, ConverterParameter=12}" Height="{Binding ChatTextFontSize, ElementName=ChatPanel, Converter={StaticResource ChatTextFontSizeConverter}, ConverterParameter=12}">
										<Path
											Data="M 6,12 L 6,0 M 1,5 L 6,0 L 11,5"
											StrokeThickness="1.8"
											Style="{StaticResource ButtonIconStrokeStyle}" />
									</Viewbox>
								</Button>
							</StackPanel>
						</Grid>
					</Grid>
				</Border>
			</Grid>

			<Popup
				x:Name="SlashPopup"
				AllowsTransparency="True"
				Closed="SlashPopup_Closed"
				DataContext="{Binding DataContext, ElementName=ChatPanel}"
				IsOpen="{Binding AreSlashSuggestionsVisible, Mode=OneWay}"
				Placement="Top"
				PlacementTarget="{Binding ElementName=ComposerCard}"
				StaysOpen="False"
				VerticalOffset="-6">
				<Border
					Width="{Binding ActualWidth, ElementName=ComposerCard}"
					MaxWidth="600"
					Padding="7"
					Background="{DynamicResource ChatPopupBackgroundBrush}"
					BorderBrush="{DynamicResource ChatBorderBrush}"
					BorderThickness="1"
					CornerRadius="12"
					PreviewMouseWheel="Popup_PreviewMouseWheel"
					TextElement.Foreground="{DynamicResource ChatForegroundBrush}">
					<StackPanel>
						<TextBlock
							Margin="10,5,10,7"
							FontSize="{Binding ChatTextFontSize, ElementName=ChatPanel, Converter={StaticResource ChatTextFontSizeConverter}, ConverterParameter=11}"
							Foreground="{DynamicResource ChatSubtleForegroundBrush}"
							Text="Session commands" />
						<ListBox
							x:Name="SlashList"
							MaxHeight="260"
							AutomationProperties.Name="Available session commands"
							ItemsSource="{Binding SlashSuggestions}"
							PreviewKeyDown="SlashList_PreviewKeyDown"
							PreviewMouseLeftButtonUp="SlashList_PreviewMouseLeftButtonUp"
							ScrollViewer.CanContentScroll="True"
							ScrollViewer.VerticalScrollBarVisibility="Auto"
							SelectedItem="{Binding SelectedSlashSuggestion, Mode=TwoWay}"
							Style="{StaticResource ConfigListStyle}"
							VirtualizingPanel.IsVirtualizing="True"
							VirtualizingPanel.VirtualizationMode="Recycling">
							<ListBox.ItemContainerStyle>
								<Style BasedOn="{StaticResource ConfigItemStyle}" TargetType="ListBoxItem">
									<Style.Triggers>
										<Trigger Property="IsSelected" Value="True">
											<Setter Property="Background" Value="{DynamicResource ChatSelectionBrush}" />
											<Setter Property="Foreground" Value="{DynamicResource ChatSelectionForegroundBrush}" />
										</Trigger>
									</Style.Triggers>
								</Style>
							</ListBox.ItemContainerStyle>
							<ListBox.ItemTemplate>
								<DataTemplate>
									<StackPanel>
										<TextBlock
											FontSize="{Binding ChatTextFontSize, RelativeSource={RelativeSource AncestorType=views:ChatPanelView}, Converter={StaticResource ChatTextFontSizeConverter}, ConverterParameter=13}"
											FontWeight="SemiBold"
											TextWrapping="Wrap">
											<Run Text="/" /><Run Text="{Binding Name, Mode=OneWay}" />
										</TextBlock>
										<TextBlock
											Margin="0,3,0,0"
											FontSize="{Binding ChatTextFontSize, RelativeSource={RelativeSource AncestorType=views:ChatPanelView}, Converter={StaticResource ChatTextFontSizeConverter}, ConverterParameter=11}"
											Text="{Binding Description}"
											TextWrapping="Wrap" />
										<TextBlock
											Margin="0,3,0,0"
											FontSize="{Binding ChatTextFontSize, RelativeSource={RelativeSource AncestorType=views:ChatPanelView}, Converter={StaticResource ChatTextFontSizeConverter}, ConverterParameter=11}"
											FontStyle="Italic"
											Text="{Binding InputHint}"
											TextWrapping="Wrap"
											Visibility="{Binding InputHint, Converter={StaticResource NullToVisibilityConverter}}" />
									</StackPanel>
								</DataTemplate>
							</ListBox.ItemTemplate>
						</ListBox>
						<TextBlock
							Margin="10,5"
							AutomationProperties.LiveSetting="Polite"
							FontSize="{Binding ChatTextFontSize, ElementName=ChatPanel, Converter={StaticResource ChatTextFontSizeConverter}, ConverterParameter=11}"
							Foreground="{DynamicResource ChatSubtleForegroundBrush}"
							Text="{Binding CommandCatalogStatus}"
							TextWrapping="Wrap"
							Visibility="{Binding CommandCatalogStatus, Converter={StaticResource NullToVisibilityConverter}}" />
						<Border
							Height="1"
							Margin="4,5"
							Background="{DynamicResource ChatBorderBrush}" />
						<TextBlock
							Margin="10,5"
							FontSize="{Binding ChatTextFontSize, ElementName=ChatPanel, Converter={StaticResource ChatTextFontSizeConverter}, ConverterParameter=10}"
							Foreground="{DynamicResource ChatSubtleForegroundBrush}"
							Text="Commands advertised by this session, including exposed skills/plugins. Manage plugins in Claude Code CLI."
							TextWrapping="Wrap" />
					</StackPanel>
				</Border>
			</Popup>

			<Popup
				x:Name="ModelPopup"
				AllowsTransparency="True"
				Closed="ModelPopup_Closed"
				DataContext="{Binding DataContext, ElementName=ChatPanel}"
				Opened="ModelPopup_Opened"
				Placement="Top"
				PlacementTarget="{Binding ElementName=ComposerCard}"
				StaysOpen="False"
				VerticalOffset="-6">
				<Border
					Width="{Binding ActualWidth, ElementName=ComposerCard}"
					MaxHeight="{Binding ChatTextFontSize, ElementName=ChatPanel, Converter={StaticResource ChatTextFontSizeConverter}, ConverterParameter=440}"
					Padding="7"
					Background="{DynamicResource ChatPopupBackgroundBrush}"
					BorderBrush="{DynamicResource ChatBorderBrush}"
					BorderThickness="1"
					CornerRadius="12"
					KeyboardNavigation.TabNavigation="Cycle"
					PreviewKeyDown="ModelPopup_PreviewKeyDown"
					PreviewMouseWheel="Popup_PreviewMouseWheel"
					TextElement.Foreground="{DynamicResource ChatForegroundBrush}">
					<Grid>
						<Grid x:Name="ModelPickerView">
							<Grid.RowDefinitions>
								<RowDefinition Height="Auto" />
								<RowDefinition Height="*" />
								<RowDefinition Height="Auto" />
							</Grid.RowDefinitions>
							<TextBlock
								Grid.Row="0"
								Margin="11,6,11,5"
								FontSize="{Binding ChatTextFontSize, ElementName=ChatPanel, Converter={StaticResource ChatTextFontSizeConverter}, ConverterParameter=11}"
								Foreground="{DynamicResource ChatSubtleForegroundBrush}"
								Text="Model" />
							<ListBox
								x:Name="ModelList"
								Grid.Row="1"
								AutomationProperties.Name="Model"
								IsEnabled="{Binding CanConfigure}"
								ItemContainerStyle="{StaticResource ConfigItemStyle}"
								ItemTemplate="{StaticResource ConfigValueTemplate}"
								ItemsSource="{Binding AvailableModels}"
								PreviewKeyDown="ConfigList_PreviewKeyDown"
								PreviewMouseLeftButtonUp="ConfigList_PreviewMouseLeftButtonUp"
								SelectedItem="{Binding SelectedModel, Mode=OneWay}"
								Style="{StaticResource ConfigScrollingListStyle}" />
							<StackPanel Grid.Row="2" Visibility="{Binding HasEffort, Converter={StaticResource BoolToVisibilityConverter}}">
								<Border
									Height="1"
									Margin="5,8,5,5"
									Background="{DynamicResource ChatBorderBrush}" />
								<Button
									x:Name="EffortButton"
									Padding="10,9"
									HorizontalContentAlignment="Stretch"
									AutomationProperties.Name="Change reasoning effort"
									Click="EffortButton_Click"
									FontSize="{Binding ChatTextFontSize, ElementName=ChatPanel, Converter={StaticResource ChatTextFontSizeConverter}, ConverterParameter=12}"
									Foreground="{DynamicResource ChatForegroundBrush}"
									IsEnabled="{Binding CanConfigure}"
									Style="{StaticResource LinkButtonStyle}"
									ToolTip="Choose reasoning effort">
									<Grid>
										<Grid.ColumnDefinitions>
											<ColumnDefinition Width="*" />
											<ColumnDefinition Width="Auto" />
											<ColumnDefinition Width="Auto" />
										</Grid.ColumnDefinitions>
										<TextBlock VerticalAlignment="Center" Text="Effort" />
										<TextBlock
											Grid.Column="1"
											Margin="12,0"
											VerticalAlignment="Center"
											Foreground="{DynamicResource ChatSubtleForegroundBrush}"
											Text="{Binding ActiveEffortName}" />
										<Path
											Grid.Column="2"
											VerticalAlignment="Center"
											Data="M 0,0 L 4,4 L 0,8"
											StrokeThickness="1.3"
											Style="{StaticResource ButtonIconStrokeStyle}" />
									</Grid>
								</Button>
							</StackPanel>
						</Grid>
						<Grid x:Name="EffortPickerView" Visibility="Collapsed">
							<Grid.RowDefinitions>
								<RowDefinition Height="Auto" />
								<RowDefinition Height="*" />
							</Grid.RowDefinitions>
							<Button
								Grid.Row="0"
								Margin="0,0,0,5"
								Padding="10,9"
								HorizontalContentAlignment="Left"
								AutomationProperties.Name="Back to models"
								Click="EffortBackButton_Click"
								Foreground="{DynamicResource ChatForegroundBrush}"
								Style="{StaticResource LinkButtonStyle}"
								ToolTip="Back to models (Escape or Left)">
								<StackPanel Orientation="Horizontal">
									<Path
										Margin="0,0,12,0"
										VerticalAlignment="Center"
										Data="M 4,0 L 0,4 L 4,8"
										StrokeThickness="1.3"
										Style="{StaticResource ButtonIconStrokeStyle}" />
									<TextBlock
										FontSize="{Binding ChatTextFontSize, ElementName=ChatPanel, Converter={StaticResource ChatTextFontSizeConverter}, ConverterParameter=12}"
										FontWeight="SemiBold"
										Text="Effort" />
								</StackPanel>
							</Button>
							<ListBox
								x:Name="EffortList"
								Grid.Row="1"
								AutomationProperties.Name="Reasoning effort"
								IsEnabled="{Binding CanConfigure}"
								ItemContainerStyle="{StaticResource ConfigItemStyle}"
								ItemTemplate="{StaticResource ConfigValueTemplate}"
								ItemsSource="{Binding AvailableEfforts}"
								PreviewKeyDown="ConfigList_PreviewKeyDown"
								PreviewMouseLeftButtonUp="ConfigList_PreviewMouseLeftButtonUp"
								SelectedItem="{Binding SelectedEffort, Mode=OneWay}"
								Style="{StaticResource ConfigScrollingListStyle}" />
						</Grid>
					</Grid>
				</Border>
			</Popup>

			<Popup
				x:Name="ModePopup"
				AllowsTransparency="True"
				DataContext="{Binding DataContext, ElementName=ChatPanel}"
				Opened="ModePopup_Opened"
				Placement="Top"
				PlacementTarget="{Binding ElementName=ComposerCard}"
				StaysOpen="False"
				VerticalOffset="-6">
				<Border
					Width="{Binding ActualWidth, ElementName=ComposerCard}"
					MaxHeight="{Binding ChatTextFontSize, ElementName=ChatPanel, Converter={StaticResource ChatTextFontSizeConverter}, ConverterParameter=360}"
					Padding="7"
					Background="{DynamicResource ChatPopupBackgroundBrush}"
					BorderBrush="{DynamicResource ChatBorderBrush}"
					BorderThickness="1"
					CornerRadius="12"
					PreviewMouseWheel="Popup_PreviewMouseWheel"
					TextElement.Foreground="{DynamicResource ChatForegroundBrush}">
					<Grid>
						<Grid.RowDefinitions>
							<RowDefinition Height="Auto" />
							<RowDefinition Height="*" />
						</Grid.RowDefinitions>
						<TextBlock
							Grid.Row="0"
							Margin="11,6,11,5"
							FontSize="{Binding ChatTextFontSize, ElementName=ChatPanel, Converter={StaticResource ChatTextFontSizeConverter}, ConverterParameter=11}"
							Foreground="{DynamicResource ChatSubtleForegroundBrush}"
							Text="Mode" />
						<!--
							No wrapping ScrollViewer: the list's own one would handle every wheel event and starve it
							(see ConfigScrollingListStyle), so the list, bounded by the star row, scrolls itself.
						-->
						<ListBox
							x:Name="ModeList"
							Grid.Row="1"
							Margin="0,0,0,6"
							AutomationProperties.Name="Session mode"
							IsEnabled="{Binding CanConfigure}"
							ItemContainerStyle="{StaticResource ConfigItemStyle}"
							ItemTemplate="{StaticResource ModeValueTemplate}"
							ItemsSource="{Binding AvailableModes}"
							PreviewKeyDown="ConfigList_PreviewKeyDown"
							PreviewMouseLeftButtonUp="ConfigList_PreviewMouseLeftButtonUp"
							SelectedItem="{Binding SelectedMode, Mode=OneWay}"
							Style="{StaticResource ConfigListStyle}" />
					</Grid>
				</Border>
			</Popup>

			<Popup
				x:Name="HistoryPopup"
				AllowsTransparency="True"
				Closed="HistoryPopup_Closed"
				DataContext="{Binding DataContext, ElementName=ChatPanel}"
				IsOpen="{Binding IsHistoryOpen, Mode=OneWay}"
				Opened="HistoryPopup_Opened"
				Placement="Bottom"
				PlacementTarget="{Binding ElementName=HeaderBar}"
				StaysOpen="False"
				VerticalOffset="8">
				<Border
					Width="{Binding ActualWidth, ElementName=HeaderBar}"
					Padding="7"
					Background="{DynamicResource ChatPopupBackgroundBrush}"
					BorderBrush="{DynamicResource ChatBorderBrush}"
					BorderThickness="1"
					CornerRadius="12"
					PreviewMouseWheel="Popup_PreviewMouseWheel"
					TextElement.Foreground="{DynamicResource ChatForegroundBrush}">
					<Grid MaxHeight="520">
						<Grid.RowDefinitions>
							<RowDefinition Height="Auto" />
							<RowDefinition Height="Auto" />
							<RowDefinition Height="*" />
						</Grid.RowDefinitions>
						<Grid Grid.Row="0" Margin="4,2,0,4">
							<Grid.ColumnDefinitions>
								<ColumnDefinition Width="Auto" />
								<ColumnDefinition Width="*" />
								<ColumnDefinition Width="Auto" />
							</Grid.ColumnDefinitions>
							<Grid
								Grid.Column="0"
								Width="14"
								Height="14"
								Margin="6,0,8,0"
								VerticalAlignment="Center">
								<Ellipse
									Width="9"
									Height="9"
									HorizontalAlignment="Left"
									VerticalAlignment="Top"
									Stroke="{DynamicResource ChatSubtleForegroundBrush}"
									StrokeThickness="1.4" />
								<Path
									Data="M 8,8 L 13,13"
									Stroke="{DynamicResource ChatSubtleForegroundBrush}"
									StrokeThickness="1.4" />
							</Grid>
							<TextBox
								x:Name="HistoryFilterBox"
								Grid.Column="1"
								Padding="0,6"
								AutomationProperties.HelpText="Filters the session list below by title or session id."
								AutomationProperties.Name="Search sessions"
								Background="Transparent"
								BorderThickness="0"
								CaretBrush="{DynamicResource ChatForegroundBrush}"
								FontSize="{Binding ChatTextFontSize, ElementName=ChatPanel, Converter={StaticResource ChatTextFontSizeConverter}, ConverterParameter=13}"
								Foreground="{DynamicResource ChatForegroundBrush}"
								Text="{Binding HistoryFilter, UpdateSourceTrigger=PropertyChanged}" />
							<TextBlock
								Grid.Column="1"
								Margin="0,6"
								VerticalAlignment="Center"
								FontSize="{Binding ChatTextFontSize, ElementName=ChatPanel, Converter={StaticResource ChatTextFontSizeConverter}, ConverterParameter=13}"
								Foreground="{DynamicResource ChatSubtleForegroundBrush}"
								IsHitTestVisible="False"
								Text="Search sessions…">
								<TextBlock.Style>
									<Style TargetType="TextBlock">
										<Setter Property="Visibility" Value="Collapsed" />
										<Style.Triggers>
											<DataTrigger Binding="{Binding Text.Length, ElementName=HistoryFilterBox}" Value="0">
												<Setter Property="Visibility" Value="Visible" />
											</DataTrigger>
										</Style.Triggers>
									</Style>
								</TextBlock.Style>
							</TextBlock>
							<Button
								Grid.Column="2"
								Width="24"
								Height="24"
								AutomationProperties.Name="Close history"
								Click="HistoryCloseButton_Click"
								Style="{StaticResource LinkButtonStyle}"
								ToolTip="Close">
								<Path
									Data="M 0,0 L 8,8 M 0,8 L 8,0"
									StrokeThickness="1.5"
									Style="{StaticResource ButtonIconStrokeStyle}" />
							</Button>
						</Grid>
						<Border
							Grid.Row="1"
							Height="1"
							Margin="4,0,4,4"
							Background="{DynamicResource ChatBorderBrush}" />
						<TextBlock
							Grid.Row="2"
							Margin="11,6"
							FontSize="{Binding ChatTextFontSize, ElementName=ChatPanel, Converter={StaticResource ChatTextFontSizeConverter}, ConverterParameter=12}"
							Foreground="{DynamicResource ChatSubtleForegroundBrush}"
							Text="Loading…"
							Visibility="{Binding IsHistoryLoading, Converter={StaticResource BoolToVisibilityConverter}}" />
						<TextBlock
							Grid.Row="2"
							Margin="11,6"
							FontSize="{Binding ChatTextFontSize, ElementName=ChatPanel, Converter={StaticResource ChatTextFontSizeConverter}, ConverterParameter=12}"
							Foreground="{DynamicResource ChatErrorForegroundBrush}"
							Text="{Binding HistoryError}"
							TextWrapping="Wrap"
							Visibility="{Binding HistoryError, Converter={StaticResource NullToVisibilityConverter}}" />
						<TextBlock
							Grid.Row="2"
							Margin="11,6"
							FontSize="{Binding ChatTextFontSize, ElementName=ChatPanel, Converter={StaticResource ChatTextFontSizeConverter}, ConverterParameter=12}"
							Foreground="{DynamicResource ChatSubtleForegroundBrush}"
							Text="No sessions match your search."
							TextWrapping="Wrap">
							<TextBlock.Style>
								<Style TargetType="TextBlock">
									<Setter Property="Visibility" Value="Collapsed" />
									<Style.Triggers>
										<MultiDataTrigger>
											<MultiDataTrigger.Conditions>
												<Condition Binding="{Binding IsHistoryLoading}" Value="False" />
												<Condition Binding="{Binding HistoryError}" Value="{x:Null}" />
												<Condition Binding="{Binding SessionHistory.Count}" Value="0" />
											</MultiDataTrigger.Conditions>
											<Setter Property="Visibility" Value="Visible" />
										</MultiDataTrigger>
									</Style.Triggers>
								</Style>
							</TextBlock.Style>
						</TextBlock>
						<!--
							The ScrollViewer lives *inside* the ItemsControl: a plain ItemsControl does not
							implement IScrollInfo, so with the ScrollViewer wrapped around it instead the child
							was measured with infinite height and the VirtualizingStackPanel realised every one
							of a long-lived workspace's sessions (rebuilt on each filter keystroke).
						-->
						<ItemsControl
							x:Name="HistoryList"
							Grid.Row="2"
							AutomationProperties.Name="Session history"
							ItemsSource="{Binding SessionHistory}"
							VirtualizingPanel.IsVirtualizing="True"
							VirtualizingPanel.ScrollUnit="Pixel"
							VirtualizingPanel.VirtualizationMode="Recycling"
							Visibility="{Binding IsHistoryLoading, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Invert}">
							<ItemsControl.Template>
								<ControlTemplate TargetType="ItemsControl">
									<ScrollViewer
										CanContentScroll="True"
										Focusable="False"
										HorizontalScrollBarVisibility="Disabled"
										VerticalScrollBarVisibility="Auto">
										<ItemsPresenter />
									</ScrollViewer>
								</ControlTemplate>
							</ItemsControl.Template>
							<ItemsControl.ItemTemplate>
								<DataTemplate DataType="{x:Type contracts:SessionSummary}">
									<Button
										Padding="10,9"
										HorizontalContentAlignment="Stretch"
										AutomationProperties.Name="{Binding Converter={StaticResource SessionTitleConverter}}"
										Command="{Binding DataContext.OpenSessionCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
										CommandParameter="{Binding}"
										FontSize="{Binding ChatTextFontSize, RelativeSource={RelativeSource AncestorType=views:ChatPanelView}, Converter={StaticResource ChatTextFontSizeConverter}, ConverterParameter=12}"
										Foreground="{DynamicResource ChatForegroundBrush}"
										Style="{StaticResource LinkButtonStyle}">
										<Grid>
											<Grid.ColumnDefinitions>
												<ColumnDefinition Width="*" />
												<ColumnDefinition Width="Auto" />
											</Grid.ColumnDefinitions>
											<TextBlock
												VerticalAlignment="Center"
												Text="{Binding Converter={StaticResource SessionTitleConverter}}"
												TextTrimming="CharacterEllipsis" />
											<TextBlock
												Grid.Column="1"
												Margin="12,0,0,0"
												VerticalAlignment="Center"
												FontSize="{Binding ChatTextFontSize, RelativeSource={RelativeSource AncestorType=views:ChatPanelView}, Converter={StaticResource ChatTextFontSizeConverter}, ConverterParameter=11}"
												Foreground="{DynamicResource ChatSubtleForegroundBrush}"
												Text="{Binding UpdatedAt, Converter={StaticResource RelativeTimeConverter}}"
												ToolTip="{Binding UpdatedAt, StringFormat='{}{0:f}'}" />
										</Grid>
									</Button>
								</DataTemplate>
							</ItemsControl.ItemTemplate>
							<ItemsControl.ItemsPanel>
								<ItemsPanelTemplate>
									<VirtualizingStackPanel />
								</ItemsPanelTemplate>
							</ItemsControl.ItemsPanel>
						</ItemsControl>
					</Grid>
				</Border>
			</Popup>

			<Popup
				x:Name="UsagePopup"
				AllowsTransparency="True"
				Closed="UsagePopup_Closed"
				DataContext="{Binding DataContext, ElementName=ChatPanel}"
				IsOpen="{Binding IsUsagePanelOpen, Mode=OneWay}"
				Placement="Top"
				PlacementTarget="{Binding ElementName=ComposerCard}"
				StaysOpen="False"
				VerticalOffset="-6">
				<Border
					x:Name="UsagePopupBorder"
					Width="{Binding ActualWidth, ElementName=ComposerCard}"
					Padding="7"
					Background="{DynamicResource ChatPopupBackgroundBrush}"
					BorderBrush="{DynamicResource ChatBorderBrush}"
					BorderThickness="1"
					CornerRadius="12"
					PreviewMouseWheel="Popup_PreviewMouseWheel"
					TextElement.Foreground="{DynamicResource ChatForegroundBrush}">
					<StackPanel>
						<StackPanel.Resources>
							<DataTemplate x:Key="UsageLimitRowTemplate" DataType="{x:Type vm:UsageLimitDisplay}">
								<Grid Margin="11,6,11,7">
									<Grid.ColumnDefinitions>
										<ColumnDefinition Width="*" />
										<ColumnDefinition Width="Auto" />
									</Grid.ColumnDefinitions>
									<Grid.RowDefinitions>
										<RowDefinition Height="Auto" />
										<RowDefinition Height="Auto" />
										<RowDefinition Height="Auto" />
									</Grid.RowDefinitions>
									<TextBlock
										Grid.Row="0"
										Grid.Column="0"
										VerticalAlignment="Center"
										FontSize="{Binding ChatTextFontSize, RelativeSource={RelativeSource AncestorType=views:ChatPanelView}, Converter={StaticResource ChatTextFontSizeConverter}, ConverterParameter=12}"
										Text="{Binding Label}" />
									<TextBlock
										Grid.Row="0"
										Grid.Column="1"
										VerticalAlignment="Center"
										FontSize="{Binding ChatTextFontSize, RelativeSource={RelativeSource AncestorType=views:ChatPanelView}, Converter={StaticResource ChatTextFontSizeConverter}, ConverterParameter=12}"
										FontWeight="SemiBold"
										Text="{Binding Percent, Mode=OneWay, StringFormat={}{0}% used}">
										<TextBlock.Style>
											<Style TargetType="TextBlock">
												<Setter Property="Foreground" Value="{DynamicResource ChatForegroundBrush}" />
												<Style.Triggers>
													<DataTrigger Binding="{Binding IsWarning}" Value="True">
														<Setter Property="Foreground" Value="{DynamicResource ChatErrorForegroundBrush}" />
													</DataTrigger>
												</Style.Triggers>
											</Style>
										</TextBlock.Style>
									</TextBlock>
									<Grid
										Grid.Row="1"
										Grid.Column="0"
										Grid.ColumnSpan="2"
										Height="4"
										Margin="0,5,0,0">
										<Border Background="{DynamicResource ChatBorderBrush}" CornerRadius="2" />
										<Grid>
											<Grid.ColumnDefinitions>
												<ColumnDefinition Width="{Binding Percent, Converter={StaticResource PercentToStarWidthConverter}}" />
												<ColumnDefinition Width="{Binding Percent, Converter={StaticResource PercentToStarWidthConverter}, ConverterParameter=Invert}" />
											</Grid.ColumnDefinitions>
											<Border Grid.Column="0" CornerRadius="2">
												<Border.Style>
													<Style TargetType="Border">
														<Setter Property="Background" Value="{DynamicResource ChatAccentBrush}" />
														<Style.Triggers>
															<DataTrigger Binding="{Binding IsWarning}" Value="True">
																<Setter Property="Background" Value="{DynamicResource ChatErrorForegroundBrush}" />
															</DataTrigger>
														</Style.Triggers>
													</Style>
												</Border.Style>
											</Border>
										</Grid>
									</Grid>
									<TextBlock
										Grid.Row="2"
										Grid.Column="0"
										Grid.ColumnSpan="2"
										Margin="0,4,0,0"
										FontSize="{Binding ChatTextFontSize, RelativeSource={RelativeSource AncestorType=views:ChatPanelView}, Converter={StaticResource ChatTextFontSizeConverter}, ConverterParameter=10}"
										Foreground="{DynamicResource ChatSubtleForegroundBrush}"
										Text="{Binding ResetText}"
										Visibility="{Binding ResetText, Converter={StaticResource NullToVisibilityConverter}}" />
								</Grid>
							</DataTemplate>
						</StackPanel.Resources>
						<Grid>
							<Grid.ColumnDefinitions>
								<ColumnDefinition Width="*" />
								<ColumnDefinition Width="Auto" />
							</Grid.ColumnDefinitions>
							<TextBlock
								Grid.Column="0"
								Margin="11,6,11,5"
								VerticalAlignment="Center"
								FontSize="{Binding ChatTextFontSize, ElementName=ChatPanel, Converter={StaticResource ChatTextFontSizeConverter}, ConverterParameter=11}"
								Foreground="{DynamicResource ChatSubtleForegroundBrush}"
								Text="Usage" />
							<Button
								Grid.Column="1"
								Width="24"
								Height="24"
								AutomationProperties.Name="Close usage"
								Click="UsageCloseButton_Click"
								Style="{StaticResource LinkButtonStyle}"
								ToolTip="Close">
								<Path
									Data="M 0,0 L 8,8 M 0,8 L 8,0"
									StrokeThickness="1.5"
									Style="{StaticResource ButtonIconStrokeStyle}" />
							</Button>
						</Grid>
						<ContentControl
							Content="{Binding SessionUsage}"
							ContentTemplate="{StaticResource UsageLimitRowTemplate}"
							Visibility="{Binding SessionUsage, Converter={StaticResource NullToVisibilityConverter}}" />
						<ContentControl
							Content="{Binding WeeklyUsage}"
							ContentTemplate="{StaticResource UsageLimitRowTemplate}"
							Visibility="{Binding WeeklyUsage, Converter={StaticResource NullToVisibilityConverter}}" />
						<ContentControl
							Content="{Binding ScopedWeeklyUsage}"
							ContentTemplate="{StaticResource UsageLimitRowTemplate}"
							Visibility="{Binding ScopedWeeklyUsage, Converter={StaticResource NullToVisibilityConverter}}" />
						<TextBlock
							Margin="11,6,11,8"
							FontSize="{Binding ChatTextFontSize, ElementName=ChatPanel, Converter={StaticResource ChatTextFontSizeConverter}, ConverterParameter=12}"
							Foreground="{DynamicResource ChatSubtleForegroundBrush}"
							Text="No usage data available."
							TextWrapping="Wrap"
							Visibility="{Binding Usage, Converter={StaticResource NullToVisibilityConverter}, ConverterParameter=Invert}" />
					</StackPanel>
				</Border>
			</Popup>
		</Grid>
	</Grid>
</UserControl>
