<UserControl x:Class="ClaudeCode.Core.Views.PlanDocumentView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:ClaudeCode.Core.Views.Converters"
             xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
             x:Name="PlanRoot" UseLayoutRounding="True" SnapsToDevicePixels="True"
             Background="{DynamicResource ChatBackgroundBrush}"
             TextElement.Foreground="{DynamicResource ChatForegroundBrush}">

  <UserControl.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/EdgarusLabs.ClaudeCode.Core;component/Themes/ChatBrushes.xaml" />
      </ResourceDictionary.MergedDictionaries>
      <conv:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />

      <Style x:Key="PlanButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="{DynamicResource ChatAccentBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource ChatAccentForegroundBrush}" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="14,6" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="Button">
              <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="8"
                      BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                      Padding="{TemplateBinding Padding}">
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                  <Setter TargetName="Bd" Property="Opacity" Value="0.85" />
                </Trigger>
                <Trigger Property="IsKeyboardFocused" Value="True">
                  <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource ChatFocusBrush}" />
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                  <Setter TargetName="Bd" Property="Opacity" Value="0.45" />
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>

      <Style x:Key="PlanSecondaryButtonStyle" TargetType="Button" BasedOn="{StaticResource PlanButtonStyle}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource ChatForegroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource ChatBorderBrush}" />
      </Style>
    </ResourceDictionary>
  </UserControl.Resources>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <!-- Header: title + status on the left, Review / Proceed on the right (Antigravity-style plan page). -->
    <Border Grid.Row="0" BorderBrush="{DynamicResource ChatBorderBrush}" BorderThickness="0,0,0,1" Padding="20,10">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <TextBlock Text="Implementation Plan" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" />
          <TextBlock Text="{Binding Status}" FontSize="12" Margin="14,0,0,0" VerticalAlignment="Center"
                     Foreground="{DynamicResource ChatSubtleForegroundBrush}"
                     Visibility="{Binding IsResolved, Converter={StaticResource BoolToVisibilityConverter}}" />
          <TextBlock x:Name="PlanNotice" FontSize="12" Margin="14,0,0,0" VerticalAlignment="Center"
                     MaxWidth="420" TextTrimming="CharacterEllipsis" Visibility="Collapsed"
                     Foreground="{DynamicResource ChatSubtleForegroundBrush}" AutomationProperties.LiveSetting="Polite" />
        </StackPanel>
        <Button x:Name="ReviewButton" Grid.Column="1" Content="Review" Margin="0,0,8,0" Click="ReviewButton_Click"
                AutomationProperties.Name="Review the plan"
                ToolTip="Send comments back to Claude and keep planning">
          <Button.Style>
            <Style TargetType="Button" BasedOn="{StaticResource PlanSecondaryButtonStyle}">
              <Style.Triggers>
                <DataTrigger Binding="{Binding IsResolved}" Value="True">
                  <Setter Property="IsEnabled" Value="False" />
                </DataTrigger>
                <DataTrigger Binding="{Binding RejectOption}" Value="{x:Null}">
                  <Setter Property="IsEnabled" Value="False" />
                </DataTrigger>
                <DataTrigger Binding="{Binding}" Value="{x:Null}">
                  <Setter Property="IsEnabled" Value="False" />
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </Button.Style>
        </Button>
        <Button Grid.Column="2" Content="Proceed" Command="{Binding ProceedCommand}"
                Style="{StaticResource PlanButtonStyle}" AutomationProperties.Name="Proceed with the plan"
                ToolTip="Approve the plan and start implementing" />
      </Grid>
    </Border>

    <!-- Review comments -->
    <Border Grid.Row="1" x:Name="ReviewPanel" Visibility="Collapsed"
            Background="{DynamicResource ChatInputBackgroundBrush}"
            BorderBrush="{DynamicResource ChatBorderBrush}" BorderThickness="0,0,0,1" Padding="20,10">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock Text="Review comments — Claude will revise the plan before implementing." FontSize="12" Margin="0,0,0,6"
                   Foreground="{DynamicResource ChatSubtleForegroundBrush}" />
        <Grid Grid.Row="1">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <TextBox x:Name="ReviewBox" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="60" MaxHeight="200"
                   VerticalScrollBarVisibility="Auto" Padding="8,6" FontSize="13"
                   Background="{DynamicResource ChatBackgroundBrush}" Foreground="{DynamicResource ChatForegroundBrush}"
                   CaretBrush="{DynamicResource ChatForegroundBrush}" BorderBrush="{DynamicResource ChatBorderBrush}"
                   AutomationProperties.Name="Review comments" />
          <Button Grid.Column="1" Content="Cancel" Margin="8,0,0,0" VerticalAlignment="Bottom" Click="ReviewCancel_Click"
                  Style="{StaticResource PlanSecondaryButtonStyle}" />
          <Button Grid.Column="2" Content="Send review" Margin="8,0,0,0" VerticalAlignment="Bottom" Click="ReviewSend_Click"
                  Style="{StaticResource PlanButtonStyle}" AutomationProperties.Name="Send review comments" />
        </Grid>
      </Grid>
    </Border>

    <wv2:WebView2 x:Name="PlanView" Grid.Row="2" DefaultBackgroundColor="Transparent" />
  </Grid>
</UserControl>
