<UserControl
	x:Class="ClaudeCode.Core.Views.PlanDocumentView"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:conv="clr-namespace:ClaudeCode.Core.Views.Converters"
	xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
	x:Name="PlanRoot"
	Background="{DynamicResource ChatBackgroundBrush}"
	SnapsToDevicePixels="True"
	TextElement.Foreground="{DynamicResource ChatForegroundBrush}"
	UseLayoutRounding="True">

	<UserControl.Resources>
		<ResourceDictionary>
			<ResourceDictionary.MergedDictionaries>
				<ResourceDictionary Source="/EdgarusLabs.ClaudeCode.Core;component/Themes/ChatBrushes.xaml" />
			</ResourceDictionary.MergedDictionaries>
			<conv:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />

			<Style x:Key="PlanButtonStyle" TargetType="Button">
				<Setter Property="Background" Value="{DynamicResource ChatAccentBrush}" />
				<Setter Property="Foreground" Value="{DynamicResource ChatAccentForegroundBrush}" />
				<Setter Property="BorderBrush" Value="Transparent" />
				<Setter Property="BorderThickness" Value="1" />
				<Setter Property="Padding" Value="14,6" />
				<Setter Property="FontSize" Value="13" />
				<Setter Property="Cursor" Value="Hand" />
				<Setter Property="Template">
					<Setter.Value>
						<ControlTemplate TargetType="Button">
							<Border
								x:Name="Bd"
								Padding="{TemplateBinding Padding}"
								Background="{TemplateBinding Background}"
								BorderBrush="{TemplateBinding BorderBrush}"
								BorderThickness="{TemplateBinding BorderThickness}"
								CornerRadius="8">
								<ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
							</Border>
							<ControlTemplate.Triggers>
								<Trigger Property="IsMouseOver" Value="True">
									<Setter TargetName="Bd" Property="Opacity" Value="0.85" />
								</Trigger>
								<Trigger Property="IsKeyboardFocused" Value="True">
									<Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource ChatFocusBrush}" />
								</Trigger>
								<Trigger Property="IsEnabled" Value="False">
									<Setter TargetName="Bd" Property="Opacity" Value="0.45" />
								</Trigger>
							</ControlTemplate.Triggers>
						</ControlTemplate>
					</Setter.Value>
				</Setter>
			</Style>

			<Style
				x:Key="PlanSecondaryButtonStyle"
				BasedOn="{StaticResource PlanButtonStyle}"
				TargetType="Button">
				<Setter Property="Background" Value="Transparent" />
				<Setter Property="Foreground" Value="{DynamicResource ChatForegroundBrush}" />
				<Setter Property="BorderBrush" Value="{DynamicResource ChatBorderBrush}" />
			</Style>
		</ResourceDictionary>
	</UserControl.Resources>

	<Grid>
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto" />
			<RowDefinition Height="Auto" />
			<RowDefinition Height="*" />
		</Grid.RowDefinitions>

		<!--  Header: title + status on the left, Review / Proceed on the right (Antigravity-style plan page).  -->
		<Border
			Grid.Row="0"
			Padding="20,10"
			BorderBrush="{DynamicResource ChatBorderBrush}"
			BorderThickness="0,0,0,1">
			<Grid>
				<Grid.ColumnDefinitions>
					<ColumnDefinition Width="*" />
					<ColumnDefinition Width="Auto" />
					<ColumnDefinition Width="Auto" />
				</Grid.ColumnDefinitions>
				<StackPanel VerticalAlignment="Center" Orientation="Horizontal">
					<TextBlock
						VerticalAlignment="Center"
						FontSize="15"
						FontWeight="SemiBold"
						Text="Implementation Plan" />
					<TextBlock
						Margin="14,0,0,0"
						VerticalAlignment="Center"
						FontSize="12"
						Foreground="{DynamicResource ChatSubtleForegroundBrush}"
						Text="{Binding Status}"
						Visibility="{Binding IsResolved, Converter={StaticResource BoolToVisibilityConverter}}" />
					<TextBlock
						x:Name="PlanNotice"
						MaxWidth="420"
						Margin="14,0,0,0"
						VerticalAlignment="Center"
						AutomationProperties.LiveSetting="Polite"
						FontSize="12"
						Foreground="{DynamicResource ChatSubtleForegroundBrush}"
						TextTrimming="CharacterEllipsis"
						Visibility="Collapsed" />
				</StackPanel>
				<Button
					x:Name="ReviewButton"
					Grid.Column="1"
					Margin="0,0,8,0"
					AutomationProperties.Name="Review the plan"
					Click="ReviewButton_Click"
					Content="Review"
					ToolTip="Send comments back to Claude and keep planning">
					<Button.Style>
						<Style BasedOn="{StaticResource PlanSecondaryButtonStyle}" TargetType="Button">
							<Style.Triggers>
								<DataTrigger Binding="{Binding IsResolved}" Value="True">
									<Setter Property="IsEnabled" Value="False" />
								</DataTrigger>
								<DataTrigger Binding="{Binding RejectOption}" Value="{x:Null}">
									<Setter Property="IsEnabled" Value="False" />
								</DataTrigger>
								<DataTrigger Binding="{Binding}" Value="{x:Null}">
									<Setter Property="IsEnabled" Value="False" />
								</DataTrigger>
							</Style.Triggers>
						</Style>
					</Button.Style>
				</Button>
				<Button
					Grid.Column="2"
					AutomationProperties.Name="Proceed with the plan"
					Command="{Binding ProceedCommand}"
					Content="Proceed"
					Style="{StaticResource PlanButtonStyle}"
					ToolTip="Approve the plan and start implementing" />
			</Grid>
		</Border>

		<!--  Review comments  -->
		<Border
			x:Name="ReviewPanel"
			Grid.Row="1"
			Padding="20,10"
			Background="{DynamicResource ChatInputBackgroundBrush}"
			BorderBrush="{DynamicResource ChatBorderBrush}"
			BorderThickness="0,0,0,1"
			Visibility="Collapsed">
			<Grid>
				<Grid.RowDefinitions>
					<RowDefinition Height="Auto" />
					<RowDefinition Height="Auto" />
				</Grid.RowDefinitions>
				<TextBlock
					Margin="0,0,0,6"
					FontSize="12"
					Foreground="{DynamicResource ChatSubtleForegroundBrush}"
					Text="Review comments — Claude will revise the plan before implementing." />
				<Grid Grid.Row="1">
					<Grid.ColumnDefinitions>
						<ColumnDefinition Width="*" />
						<ColumnDefinition Width="Auto" />
						<ColumnDefinition Width="Auto" />
					</Grid.ColumnDefinitions>
					<TextBox
						x:Name="ReviewBox"
						MinHeight="60"
						MaxHeight="200"
						Padding="8,6"
						AcceptsReturn="True"
						AutomationProperties.Name="Review comments"
						Background="{DynamicResource ChatBackgroundBrush}"
						BorderBrush="{DynamicResource ChatBorderBrush}"
						CaretBrush="{DynamicResource ChatForegroundBrush}"
						FontSize="13"
						Foreground="{DynamicResource ChatForegroundBrush}"
						TextWrapping="Wrap"
						VerticalScrollBarVisibility="Auto" />
					<Button
						Grid.Column="1"
						Margin="8,0,0,0"
						VerticalAlignment="Bottom"
						Click="ReviewCancel_Click"
						Content="Cancel"
						Style="{StaticResource PlanSecondaryButtonStyle}" />
					<Button
						Grid.Column="2"
						Margin="8,0,0,0"
						VerticalAlignment="Bottom"
						AutomationProperties.Name="Send review comments"
						Click="ReviewSend_Click"
						Content="Send review"
						Style="{StaticResource PlanButtonStyle}" />
				</Grid>
			</Grid>
		</Border>

		<wv2:WebView2
			x:Name="PlanView"
			Grid.Row="2"
			DefaultBackgroundColor="Transparent" />
	</Grid>
</UserControl>
