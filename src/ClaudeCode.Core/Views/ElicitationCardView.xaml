<UserControl x:Class="ClaudeCode.Core.Views.ElicitationCardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:vm="clr-namespace:ClaudeCode.Core.ViewModels;assembly=EdgarusLabs.ClaudeCode.Core.ViewModels"
             xmlns:conv="clr-namespace:ClaudeCode.Core.Views.Converters"
             xmlns:views="clr-namespace:ClaudeCode.Core.Views"
             xmlns:contracts="clr-namespace:ClaudeCode.Contracts;assembly=EdgarusLabs.ClaudeCode.Contracts"
             mc:Ignorable="d"
             d:DesignWidth="360"
             UseLayoutRounding="True" SnapsToDevicePixels="True">

  <!-- Card for a pending elicitation/create form (AskUserQuestion). DataContext is an
       ElicitationRequestViewModel; the host binds it and nothing else. Chrome deliberately matches
       the permission card in ChatPanelView.xaml (same brushes, radius, margins and button styles)
       so the two prompts read as one family - the host must NOT wrap this in another Border.
       No palette of its own either: every brush here is a DynamicResource that must resolve to
       the host's ChatPanelView.Resources, where the VSIX writes the live VS theme. A dictionary
       merged here would shadow those (WPF searches the element's own resources first) and pin
       the card to the standalone dark fallback under the Light and Blue themes. -->

  <UserControl.Resources>
    <ResourceDictionary>
      <conv:NullToVisibilityConverter x:Key="ElicitationNullToVisibilityConverter" />
      <conv:FractionOfConverter x:Key="ElicitationFractionOfConverter" />
      <!-- A local copy, not a StaticResource lookup into ChatPanelView.Resources: unlike the
           DynamicResource brushes above, a StaticResource only searches the resource chain of the
           XAML it sits in (this control, then its parents here, then app resources), never another
           UserControl's Resources, so the host's dictionary is out of reach by scope, not by timing. -->
      <views:ChatTextFontSizeConverter x:Key="ChatTextFontSizeConverter" />

      <Style x:Key="ElicitationButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="{DynamicResource ChatAccentBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource ChatAccentForegroundBrush}" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="12,6" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FontSize" Value="{Binding ChatTextFontSize, RelativeSource={RelativeSource AncestorType={x:Type views:ChatPanelView}}, Converter={StaticResource ChatTextFontSizeConverter}, ConverterParameter=12}" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="Button">
              <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="8"
                      BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                      Padding="{TemplateBinding Padding}">
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                  <Setter TargetName="Bd" Property="Opacity" Value="0.85" />
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                  <Setter TargetName="Bd" Property="Opacity" Value="0.65" />
                </Trigger>
                <Trigger Property="IsKeyboardFocused" Value="True">
                  <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource ChatFocusBrush}" />
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>

      <Style x:Key="ElicitationSecondaryButtonStyle" TargetType="Button" BasedOn="{StaticResource ElicitationButtonStyle}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource ChatSubtleForegroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource ChatBorderBrush}" />
      </Style>

      <!-- One option row, shared by the single- and multi-select templates below: RadioButton and
           CheckBox are both ToggleButtons, so one style templates both and the two question kinds
           cannot drift apart visually. The stock chrome (a system-sized circle or box beside
           chat-styled text) matched nothing else in the panel, so the row itself is the control: the
           same rounded, theme-brushed row the model and mode pickers use in ChatPanelView, with an
           accent check mark for the chosen option. Templated here rather than shared with those
           pickers because a StaticResource cannot reach another UserControl's Resources (see the
           note on ChatTextFontSizeConverter above) and a merged dictionary would shadow the host's
           themed brushes. Every brush stays a DynamicResource, which resolves against the templated
           element's tree - the host's palette - not this dictionary.

           The control keeps its ToggleButton identity: IsChecked still drives the view model and
           mutual exclusion still lives in ElicitationFieldViewModel, so Space/Tab and the exposed
           radio/checkbox automation peers behave exactly as before the retemplate. -->
      <Style x:Key="ElicitationOptionRowStyle" TargetType="ToggleButton">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource ChatForegroundBrush}" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Padding" Value="9,7" />
        <Setter Property="Margin" Value="0,1" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="ToggleButton">
              <Border x:Name="RowBorder" Background="{TemplateBinding Background}" CornerRadius="7"
                      BorderBrush="Transparent" BorderThickness="1" Padding="{TemplateBinding Padding}">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <!-- Reserved whether or not the check mark is drawn, so selecting an option does
                         not re-wrap the label next to it. -->
                    <ColumnDefinition Width="22" />
                  </Grid.ColumnDefinitions>
                  <ContentPresenter Grid.Column="0" HorizontalAlignment="Stretch" VerticalAlignment="Center" />
                  <Path x:Name="SelectedGlyph" Grid.Column="1" Visibility="Collapsed"
                        Data="M 1,6 L 5,10 L 12,2" StrokeThickness="1.6"
                        Stroke="{DynamicResource ChatAccentBrush}"
                        HorizontalAlignment="Right" VerticalAlignment="Center" />
                </Grid>
              </Border>
              <ControlTemplate.Triggers>
                <!-- Selection reads as an accent-outlined, tinted row plus the check mark; hover
                     only tints the background and focus only draws the focus ring, so neither is
                     mistaken for the chosen option. The tint is the hover brush rather than
                     ChatSelectionBrush: under the VS themes that one is the strong list-selection
                     colour, which is only legible against ChatSelectionForegroundBrush - and the
                     option description sets its own subtle foreground, so it cannot follow. -->
                <Trigger Property="IsChecked" Value="True">
                  <Setter TargetName="SelectedGlyph" Property="Visibility" Value="Visible" />
                  <Setter TargetName="RowBorder" Property="Background" Value="{DynamicResource ChatHoverBrush}" />
                  <Setter TargetName="RowBorder" Property="BorderBrush" Value="{DynamicResource ChatAccentBrush}" />
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                  <Setter TargetName="RowBorder" Property="Background" Value="{DynamicResource ChatHoverBrush}" />
                </Trigger>
                <Trigger Property="IsKeyboardFocused" Value="True">
                  <Setter TargetName="RowBorder" Property="BorderBrush" Value="{DynamicResource ChatFocusBrush}" />
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>

      <!-- Free text. UpdateSourceTrigger=PropertyChanged so Submit reads what is on screen even when
           the button is activated by keyboard without the box ever losing focus. MaxLength bounds
           what the user can hand back to the agent and is the view-model constant itself, so the two
           cannot drift. -->
      <DataTemplate x:Key="ElicitationTextFieldTemplate" DataType="{x:Type vm:ElicitationFieldViewModel}">
        <TextBox Text="{Binding TextValue, UpdateSourceTrigger=PropertyChanged}"
                 MaxLength="{x:Static vm:ElicitationRequestViewModel.MaxDisplayTextLength}"
                 AcceptsReturn="False" TextWrapping="Wrap" Padding="6,4"
                 FontSize="{Binding ChatTextFontSize, RelativeSource={RelativeSource AncestorType={x:Type views:ChatPanelView}}, Converter={StaticResource ChatTextFontSizeConverter}, ConverterParameter=12}"
                 Background="{DynamicResource ChatBackgroundBrush}" Foreground="{DynamicResource ChatForegroundBrush}"
                 CaretBrush="{DynamicResource ChatForegroundBrush}" BorderBrush="{DynamicResource ChatBorderBrush}"
                 AutomationProperties.Name="{Binding Title, TargetNullValue='Answer'}" />
      </DataTemplate>

      <DataTemplate x:Key="ElicitationSingleSelectTemplate" DataType="{x:Type vm:ElicitationFieldViewModel}">
        <!-- Mutual exclusion lives in ElicitationFieldViewModel, not in RadioButton.GroupName: each
             item sits in its own ContentPresenter, so WPF's implicit grouping does not apply here. -->
        <ItemsControl ItemsSource="{Binding Options}">
          <ItemsControl.ItemTemplate>
            <DataTemplate DataType="{x:Type vm:ElicitationOptionViewModel}">
              <!-- No ToolTip: the description is already rendered in full below, and a WPF ToolTip is
                   an unwrapped Popup with no MaxWidth, so an agent-authored description would paint a
                   screen-wide band. Same for the CheckBox in the multi-select template. -->
              <RadioButton IsChecked="{Binding IsSelected}" Style="{StaticResource ElicitationOptionRowStyle}"
                           AutomationProperties.Name="{Binding Label}">
                <StackPanel>
                  <TextBlock Text="{Binding Label}" TextWrapping="Wrap" FontWeight="SemiBold"
                             FontSize="{Binding ChatTextFontSize, RelativeSource={RelativeSource AncestorType={x:Type views:ChatPanelView}}, Converter={StaticResource ChatTextFontSizeConverter}, ConverterParameter=12}" />
                  <TextBlock Text="{Binding Description}" TextWrapping="Wrap" Margin="0,3,0,0"
                             FontSize="{Binding ChatTextFontSize, RelativeSource={RelativeSource AncestorType={x:Type views:ChatPanelView}}, Converter={StaticResource ChatTextFontSizeConverter}, ConverterParameter=11}"
                             Foreground="{DynamicResource ChatSubtleForegroundBrush}"
                             Visibility="{Binding Description, Converter={StaticResource ElicitationNullToVisibilityConverter}}" />
                </StackPanel>
              </RadioButton>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </DataTemplate>

      <DataTemplate x:Key="ElicitationMultiSelectTemplate" DataType="{x:Type vm:ElicitationFieldViewModel}">
        <ItemsControl ItemsSource="{Binding Options}">
          <ItemsControl.ItemTemplate>
            <DataTemplate DataType="{x:Type vm:ElicitationOptionViewModel}">
              <CheckBox IsChecked="{Binding IsSelected}" Style="{StaticResource ElicitationOptionRowStyle}"
                        AutomationProperties.Name="{Binding Label}">
                <StackPanel>
                  <TextBlock Text="{Binding Label}" TextWrapping="Wrap" FontWeight="SemiBold"
                             FontSize="{Binding ChatTextFontSize, RelativeSource={RelativeSource AncestorType={x:Type views:ChatPanelView}}, Converter={StaticResource ChatTextFontSizeConverter}, ConverterParameter=12}" />
                  <TextBlock Text="{Binding Description}" TextWrapping="Wrap" Margin="0,3,0,0"
                             FontSize="{Binding ChatTextFontSize, RelativeSource={RelativeSource AncestorType={x:Type views:ChatPanelView}}, Converter={StaticResource ChatTextFontSizeConverter}, ConverterParameter=11}"
                             Foreground="{DynamicResource ChatSubtleForegroundBrush}"
                             Visibility="{Binding Description, Converter={StaticResource ElicitationNullToVisibilityConverter}}" />
                </StackPanel>
              </CheckBox>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </DataTemplate>

      <DataTemplate x:Key="ElicitationFieldTemplate" DataType="{x:Type vm:ElicitationFieldViewModel}">
        <StackPanel Margin="0,0,0,10">
          <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,2"
                     FontSize="{Binding ChatTextFontSize, RelativeSource={RelativeSource AncestorType={x:Type views:ChatPanelView}}, Converter={StaticResource ChatTextFontSizeConverter}, ConverterParameter=12}"
                     Foreground="{DynamicResource ChatForegroundBrush}"
                     Visibility="{Binding Title, Converter={StaticResource ElicitationNullToVisibilityConverter}}" />
          <TextBlock Text="{Binding Description}" TextWrapping="Wrap" Margin="0,0,0,4"
                     FontSize="{Binding ChatTextFontSize, RelativeSource={RelativeSource AncestorType={x:Type views:ChatPanelView}}, Converter={StaticResource ChatTextFontSizeConverter}, ConverterParameter=11}"
                     Foreground="{DynamicResource ChatSubtleForegroundBrush}"
                     Visibility="{Binding Description, Converter={StaticResource ElicitationNullToVisibilityConverter}}" />
          <!-- The default (text) template must be a Style setter, not a local ContentTemplate value:
               a local value outranks a style setter, so the triggers below would never win. Trigger
               values are x:Static enum members - a DataTrigger has no target property to convert a
               bare "SingleSelect" string against, so a string never equals the bound enum. -->
          <ContentControl Content="{Binding}">
            <ContentControl.Style>
              <Style TargetType="ContentControl">
                <Setter Property="ContentTemplate" Value="{StaticResource ElicitationTextFieldTemplate}" />
                <Style.Triggers>
                  <DataTrigger Binding="{Binding Kind}" Value="{x:Static contracts:ElicitationFieldKind.SingleSelect}">
                    <Setter Property="ContentTemplate" Value="{StaticResource ElicitationSingleSelectTemplate}" />
                  </DataTrigger>
                  <DataTrigger Binding="{Binding Kind}" Value="{x:Static contracts:ElicitationFieldKind.MultiSelect}">
                    <Setter Property="ContentTemplate" Value="{StaticResource ElicitationMultiSelectTemplate}" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </ContentControl.Style>
          </ContentControl>
        </StackPanel>
      </DataTemplate>
    </ResourceDictionary>
  </UserControl.Resources>

  <Border Background="{DynamicResource ChatInputBackgroundBrush}"
          BorderBrush="{DynamicResource ChatAccentBrush}" BorderThickness="1" CornerRadius="12"
          Margin="12,6,12,0" Padding="12,10">
    <StackPanel>
      <!-- Message and fields are all agent-authored, so the whole body sits inside one bounded scroll
           region. The card lives in an Auto grid row whose only * sibling is the transcript, so
           anything left unbounded here is granted its full desired height and shoves the button row
           below it - and the composer - past the bottom edge of the tool window, where they are
           clipped and the form becomes unanswerable. The answer buttons deliberately stay outside the
           ScrollViewer so a long form cannot scroll them out of reach; ElicitationCardViewLayoutTests
           pins both halves of that.

           The bound is a share of the hosting chat panel rather than a pixel constant. A constant
           small enough to leave room on a short panel makes a long question scroll away the options
           and the free-text "Other" box on a tall one - the user then sees a scrollbar and no visible
           way to answer. Letting the card take up to 80% leaves the composer and the button row on
           screen while keeping every option reachable without scrolling in the common case. The
           ancestor is ChatPanelView, not Window: docked, the nearest Window is the whole IDE, so a
           Window-relative share was taller than the tool window itself. -->
      <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                    MaxHeight="{Binding ActualHeight, RelativeSource={RelativeSource AncestorType={x:Type views:ChatPanelView}},
                                        Converter={StaticResource ElicitationFractionOfConverter},
                                        ConverterParameter=0.8}">
        <StackPanel>
          <TextBlock x:Name="MessageText" Text="{Binding Message}" TextWrapping="Wrap" FontWeight="SemiBold"
                     FontSize="{Binding ChatTextFontSize, RelativeSource={RelativeSource AncestorType={x:Type views:ChatPanelView}}, Converter={StaticResource ChatTextFontSizeConverter}, ConverterParameter=12}"
                     Foreground="{DynamicResource ChatForegroundBrush}" Margin="0,0,0,8"
                     AutomationProperties.LiveSetting="Assertive" />
          <ItemsControl ItemsSource="{Binding Fields}" ItemTemplate="{StaticResource ElicitationFieldTemplate}" />
        </StackPanel>
      </ScrollViewer>

      <!-- Questions past MaxFields are dropped to bound the form; the agent is still told the form was
           accepted, so say what was withheld - outside the scroll region, since a notice the user can
           scroll away from is no notice at all. -->
      <TextBlock Text="{Binding TruncationNotice}" TextWrapping="Wrap" Margin="0,4,0,0"
                 FontSize="{Binding ChatTextFontSize, RelativeSource={RelativeSource AncestorType={x:Type views:ChatPanelView}}, Converter={StaticResource ChatTextFontSizeConverter}, ConverterParameter=11}"
                 Foreground="{DynamicResource ChatSubtleForegroundBrush}"
                 Visibility="{Binding TruncationNotice, Converter={StaticResource ElicitationNullToVisibilityConverter}}" />

      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,2,0,0">
        <Button Content="Decline" Margin="0,0,6,0" Command="{Binding DeclineCommand}"
                Style="{StaticResource ElicitationSecondaryButtonStyle}"
                AutomationProperties.Name="Decline this question"
                ToolTip="Tell Claude you do not want to answer" />
        <!-- No IsDefault: that would make Enter anywhere in the tool window submit this form,
             including while the user is typing in the composer. The permission card does not
             claim the default button either. -->
        <Button Content="Send" Command="{Binding SubmitCommand}"
                Style="{StaticResource ElicitationButtonStyle}"
                AutomationProperties.Name="Send answer"
                ToolTip="Send your answer to Claude" />
      </StackPanel>
    </StackPanel>
  </Border>
</UserControl>
