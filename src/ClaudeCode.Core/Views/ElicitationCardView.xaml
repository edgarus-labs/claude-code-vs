<UserControl x:Class="ClaudeCode.Core.Views.ElicitationCardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:vm="clr-namespace:ClaudeCode.Core.ViewModels;assembly=EdgarusLabs.ClaudeCode.Core.ViewModels"
             xmlns:conv="clr-namespace:ClaudeCode.Core.Views.Converters"
             xmlns:contracts="clr-namespace:ClaudeCode.Contracts;assembly=EdgarusLabs.ClaudeCode.Contracts"
             mc:Ignorable="d"
             d:DesignWidth="360"
             UseLayoutRounding="True" SnapsToDevicePixels="True">

  <!-- Card for a pending elicitation/create form (AskUserQuestion). DataContext is an
       ElicitationRequestViewModel; the host binds it and nothing else. Chrome deliberately matches
       the permission card in ChatPanelView.xaml (same brushes, radius, margins and button styles)
       so the two prompts read as one family - the host must NOT wrap this in another Border. -->

  <UserControl.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/EdgarusLabs.ClaudeCode.Core;component/Themes/ChatBrushes.xaml" />
      </ResourceDictionary.MergedDictionaries>

      <conv:NullToVisibilityConverter x:Key="ElicitationNullToVisibilityConverter" />

      <Style x:Key="ElicitationButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="{DynamicResource ChatAccentBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource ChatAccentForegroundBrush}" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="12,6" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="Button">
              <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="8"
                      BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                      Padding="{TemplateBinding Padding}">
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                  <Setter TargetName="Bd" Property="Opacity" Value="0.85" />
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                  <Setter TargetName="Bd" Property="Opacity" Value="0.65" />
                </Trigger>
                <Trigger Property="IsKeyboardFocused" Value="True">
                  <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource ChatFocusBrush}" />
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>

      <Style x:Key="ElicitationSecondaryButtonStyle" TargetType="Button" BasedOn="{StaticResource ElicitationButtonStyle}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource ChatSubtleForegroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource ChatBorderBrush}" />
      </Style>

      <!-- Free text. UpdateSourceTrigger=PropertyChanged so Submit reads what is on screen even when
           the button is activated by keyboard without the box ever losing focus. MaxLength bounds
           what the user can hand back to the agent. -->
      <DataTemplate x:Key="ElicitationTextFieldTemplate" DataType="{x:Type vm:ElicitationFieldViewModel}">
        <TextBox Text="{Binding TextValue, UpdateSourceTrigger=PropertyChanged}" MaxLength="4000"
                 AcceptsReturn="False" TextWrapping="Wrap" Padding="6,4" FontSize="12"
                 Background="{DynamicResource ChatBackgroundBrush}" Foreground="{DynamicResource ChatForegroundBrush}"
                 CaretBrush="{DynamicResource ChatForegroundBrush}" BorderBrush="{DynamicResource ChatBorderBrush}"
                 AutomationProperties.Name="{Binding Title, TargetNullValue='Answer'}" />
      </DataTemplate>

      <DataTemplate x:Key="ElicitationSingleSelectTemplate" DataType="{x:Type vm:ElicitationFieldViewModel}">
        <!-- Mutual exclusion lives in ElicitationFieldViewModel, not in RadioButton.GroupName: each
             item sits in its own ContentPresenter, so WPF's implicit grouping does not apply here. -->
        <ItemsControl ItemsSource="{Binding Options}">
          <ItemsControl.ItemTemplate>
            <DataTemplate DataType="{x:Type vm:ElicitationOptionViewModel}">
              <RadioButton IsChecked="{Binding IsSelected}" Margin="0,2" Foreground="{DynamicResource ChatForegroundBrush}"
                           AutomationProperties.Name="{Binding Label}" ToolTip="{Binding Description}">
                <StackPanel>
                  <TextBlock Text="{Binding Label}" FontSize="12" TextWrapping="Wrap" />
                  <TextBlock Text="{Binding Description}" FontSize="11" TextWrapping="Wrap"
                             Foreground="{DynamicResource ChatSubtleForegroundBrush}"
                             Visibility="{Binding Description, Converter={StaticResource ElicitationNullToVisibilityConverter}}" />
                </StackPanel>
              </RadioButton>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </DataTemplate>

      <DataTemplate x:Key="ElicitationMultiSelectTemplate" DataType="{x:Type vm:ElicitationFieldViewModel}">
        <ItemsControl ItemsSource="{Binding Options}">
          <ItemsControl.ItemTemplate>
            <DataTemplate DataType="{x:Type vm:ElicitationOptionViewModel}">
              <CheckBox IsChecked="{Binding IsSelected}" Margin="0,2" Foreground="{DynamicResource ChatForegroundBrush}"
                        AutomationProperties.Name="{Binding Label}" ToolTip="{Binding Description}">
                <StackPanel>
                  <TextBlock Text="{Binding Label}" FontSize="12" TextWrapping="Wrap" />
                  <TextBlock Text="{Binding Description}" FontSize="11" TextWrapping="Wrap"
                             Foreground="{DynamicResource ChatSubtleForegroundBrush}"
                             Visibility="{Binding Description, Converter={StaticResource ElicitationNullToVisibilityConverter}}" />
                </StackPanel>
              </CheckBox>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </DataTemplate>

      <DataTemplate x:Key="ElicitationFieldTemplate" DataType="{x:Type vm:ElicitationFieldViewModel}">
        <StackPanel Margin="0,0,0,10">
          <TextBlock Text="{Binding Title}" FontSize="12" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,2"
                     Foreground="{DynamicResource ChatForegroundBrush}"
                     Visibility="{Binding Title, Converter={StaticResource ElicitationNullToVisibilityConverter}}" />
          <TextBlock Text="{Binding Description}" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,4"
                     Foreground="{DynamicResource ChatSubtleForegroundBrush}"
                     Visibility="{Binding Description, Converter={StaticResource ElicitationNullToVisibilityConverter}}" />
          <!-- The default (text) template must be a Style setter, not a local ContentTemplate value:
               a local value outranks a style setter, so the triggers below would never win. Trigger
               values are x:Static enum members - a DataTrigger has no target property to convert a
               bare "SingleSelect" string against, so a string never equals the bound enum. -->
          <ContentControl Content="{Binding}">
            <ContentControl.Style>
              <Style TargetType="ContentControl">
                <Setter Property="ContentTemplate" Value="{StaticResource ElicitationTextFieldTemplate}" />
                <Style.Triggers>
                  <DataTrigger Binding="{Binding Kind}" Value="{x:Static contracts:ElicitationFieldKind.SingleSelect}">
                    <Setter Property="ContentTemplate" Value="{StaticResource ElicitationSingleSelectTemplate}" />
                  </DataTrigger>
                  <DataTrigger Binding="{Binding Kind}" Value="{x:Static contracts:ElicitationFieldKind.MultiSelect}">
                    <Setter Property="ContentTemplate" Value="{StaticResource ElicitationMultiSelectTemplate}" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </ContentControl.Style>
          </ContentControl>
        </StackPanel>
      </DataTemplate>
    </ResourceDictionary>
  </UserControl.Resources>

  <Border Background="{DynamicResource ChatInputBackgroundBrush}"
          BorderBrush="{DynamicResource ChatAccentBrush}" BorderThickness="1" CornerRadius="12"
          Margin="12,6,12,0" Padding="12,10">
    <StackPanel>
      <TextBlock Text="{Binding Message}" TextWrapping="Wrap" FontWeight="SemiBold"
                 Foreground="{DynamicResource ChatForegroundBrush}" Margin="0,0,0,8"
                 AutomationProperties.LiveSetting="Assertive" />

      <!-- The form is agent-authored and bounded at up to ElicitationRequestViewModel.MaxFields
           fields; scroll rather than push the composer off the panel. -->
      <ScrollViewer MaxHeight="260" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <ItemsControl ItemsSource="{Binding Fields}" ItemTemplate="{StaticResource ElicitationFieldTemplate}" />
      </ScrollViewer>

      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,2,0,0">
        <Button Content="Decline" Margin="0,0,6,0" Command="{Binding DeclineCommand}"
                Style="{StaticResource ElicitationSecondaryButtonStyle}"
                AutomationProperties.Name="Decline this question"
                ToolTip="Tell Claude you do not want to answer" />
        <!-- No IsDefault: that would make Enter anywhere in the tool window submit this form,
             including while the user is typing in the composer. The permission card does not
             claim the default button either. -->
        <Button Content="Send" Command="{Binding SubmitCommand}"
                Style="{StaticResource ElicitationButtonStyle}"
                AutomationProperties.Name="Send answer"
                ToolTip="Send your answer to Claude" />
      </StackPanel>
    </StackPanel>
  </Border>
</UserControl>
