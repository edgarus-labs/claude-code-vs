<?xml version="1.0" encoding="utf-8"?>
<CommandTable xmlns="http://schemas.microsoft.com/VisualStudio/2005-10-18/CommandTable" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">

  <Extern href="stdidcmd.h"/>
  <Extern href="vsshlids.h"/>
  <Extern href="KnownImageIds.vsct"/>

  <Commands package="guidClaudeCodePackage">

    <Groups>
      <Group guid="guidClaudeCodeCommandSet" id="ClaudeCodeMenuGroup" priority="0x0600">
        <Parent guid="guidClaudeCodeCommandSet" id="ClaudeCodeMenu"/>
      </Group>
    </Groups>

    <Menus>
      <!-- New top-level menu, inserted as a sibling of the built-in Window menu on the main menu bar. -->
      <Menu guid="guidClaudeCodeCommandSet" id="ClaudeCodeMenu" priority="0x0600" type="Menu">
        <Parent guid="guidSHLMainMenu" id="IDM_VS_MENU_WINDOW"/>
        <Strings>
          <ButtonText>Claude Code</ButtonText>
          <CommandName>Claude Code</CommandName>
        </Strings>
      </Menu>
    </Menus>

    <Bitmaps>
      <Bitmap guid="guidClaudeCodeImages" href="Resources\CommandIcon.png" usedList="ClaudeCodeIcon"/>
    </Bitmaps>

    <Buttons>
      <Button guid="guidClaudeCodeCommandSet" id="OpenChatWindowCommandId" priority="0x0100" type="Button">
        <Parent guid="guidClaudeCodeCommandSet" id="ClaudeCodeMenuGroup"/>
        <Icon guid="guidClaudeCodeImages" id="ClaudeCodeIcon"/>
        <Strings>
          <ButtonText>Claude Code Chat</ButtonText>
          <CommandName>ClaudeCode.OpenChatWindow</CommandName>
          <ToolTipText>Open the Claude Code chat window</ToolTipText>
        </Strings>
      </Button>
      <Button guid="guidClaudeCodeCommandSet" id="SignInCommandId" priority="0x0110" type="Button">
        <Parent guid="guidClaudeCodeCommandSet" id="ClaudeCodeMenuGroup"/>
        <Icon guid="ImageCatalogGuid" id="Account"/>
        <CommandFlag>IconIsMoniker</CommandFlag>
        <Strings>
          <ButtonText>Sign In to Claude Code…</ButtonText>
          <CommandName>ClaudeCode.SignIn</CommandName>
          <ToolTipText>Sign in with your Anthropic account via the Claude Code CLI</ToolTipText>
        </Strings>
      </Button>
      <Button guid="guidClaudeCodeCommandSet" id="SignOutCommandId" priority="0x0120" type="Button">
        <Parent guid="guidClaudeCodeCommandSet" id="ClaudeCodeMenuGroup"/>
        <Icon guid="ImageCatalogGuid" id="Lock"/>
        <CommandFlag>IconIsMoniker</CommandFlag>
        <Strings>
          <ButtonText>Sign Out of Claude Code</ButtonText>
          <CommandName>ClaudeCode.SignOut</CommandName>
          <ToolTipText>Sign out and remove the stored Claude Code credential</ToolTipText>
        </Strings>
      </Button>
      <!-- Same command, also placed under View > Other Windows so the tool window is discoverable
           and reopenable through Visual Studio's standard mechanism for closed/undocked tool
           windows, independent of the custom top-level "Claude Code" menu above. -->
      <Button guid="guidClaudeCodeCommandSet" id="OpenChatWindowCommandId" priority="0x0100" type="Button">
        <Parent guid="guidSHLMainMenu" id="IDG_VS_WNDO_OTRWNDWS1"/>
        <Icon guid="guidClaudeCodeImages" id="ClaudeCodeIcon"/>
        <Strings>
          <ButtonText>Claude Code</ButtonText>
          <CommandName>ClaudeCode.OpenChatWindow.OtherWindows</CommandName>
          <ToolTipText>Open the Claude Code chat window</ToolTipText>
        </Strings>
      </Button>
    </Buttons>

  </Commands>


  <Symbols>
    <GuidSymbol name="guidClaudeCodePackage" value="{8f5a6e3b-8f1a-4a6a-9d1a-3c2f7f9d2b40}"/>

    <GuidSymbol name="guidClaudeCodeImages" value="{6a1e4f2b-9c3d-47a8-b5e1-2d8f6c4a9e70}">
      <IDSymbol name="ClaudeCodeIcon" value="1"/>
    </GuidSymbol>

    <GuidSymbol name="guidClaudeCodeCommandSet" value="{3a9b6f1e-3e7c-4f2f-9c2a-2b6f5a7d9e11}">
      <IDSymbol name="ClaudeCodeMenuGroup" value="0x1020"/>
      <IDSymbol name="ClaudeCodeMenu" value="0x1030"/>
      <IDSymbol name="OpenChatWindowCommandId" value="0x0100"/>
      <IDSymbol name="SignInCommandId" value="0x0101"/>
      <IDSymbol name="SignOutCommandId" value="0x0102"/>
    </GuidSymbol>

  </Symbols>
</CommandTable>
