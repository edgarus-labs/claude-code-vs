<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <RootNamespace>ClaudeCode.Core.Tests</RootNamespace>
    <!--
      Targets net10.0 (not net472) because net472 test assemblies cannot execute on this Linux dev box without
      Mono (verified: `dotnet test` on a net472 xunit project fails with "Could not find 'mono' host"), and
      this box only has the .NET 10 runtime installed (see "dotnet list-runtimes") so net8.0 test hosts fail
      to launch here too. All logic under test (ChatViewModel and friends) lives in the XAML-free
      ClaudeCode.Core.ViewModels project (netstandard2.0), so it is fully exercisable from any modern .NET
      host with no WPF/net472 involved; retarget to whatever LTS is standard on the real build machine.
    -->
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.10.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/ClaudeCode.Core.ViewModels/ClaudeCode.Core.ViewModels.csproj" />
  </ItemGroup>

</Project>
